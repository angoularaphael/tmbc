---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page introuvable — TMBC"
  description="Cette page n’existe pas sur le site du Toulouse Minimes Boxing Club."
  path="/404"
>
  <main class="section" style="min-height:100svh;display:grid;place-content:center;text-align:center">
    <p class="eyebrow">404</p>
    <h1 class="display">Page introuvable</h1>
    <p class="lead" style="margin:1rem auto 0">Cette page n’existe pas. Revenez à l’accueil pour vous inscrire.</p>
    <p class="btn-row" style="justify-content:center;margin-top:1.6rem">
      <a class="btn btn--primary" href="/">Accueil TMBC</a>
    </p>
  </main>
</Base>
