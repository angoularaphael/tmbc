---
import Base from '../layouts/Base.astro';
const title = 'Planning — TMBC | 27 cours du lundi au samedi';
const description = 'Planning TMBC du lundi au samedi. 27 cours, accès libre. 12 rue de Fenouillet, Toulouse.';
const path = '/planning';
const preloadHero = false;
const jsonLd = undefined;
---
<Base title={title} description={description} path={path} preloadHero={preloadHero} jsonLd={jsonLd}>
<main id="main">
    <header class="phero">
      <img src="/assets/media/cross-rack-1200.webp" alt="Plateau de préparation physique" width="1200" height="800" />
      <div class="wrap" data-reveal>
        <p class="eyebrow">Lundi–samedi</p>
        <h1 class="display">27 cours. Choisissez le vôtre.</h1>
        <p class="lead">Pas d’anglaise loisirs le samedi. Pas de compétiteurs le mercredi. Grille aussi sur <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">Boxing Center Minimes</a>.</p>
      </div>
    </header>
    <aside class="juice">
      <div class="wrap">
        <p>Planning de la <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">salle de boxe Toulouse Minimes</a>, réseau <a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a>.</p>
      </div>
    </aside>
    <section class="section">
      <div class="wrap">
        <div class="filters" id="plan-filters">
          <button class="chip is-on" type="button" data-filter="all" aria-pressed="true">Tout</button>
          <button class="chip" type="button" data-filter="anglaise">Anglaise</button>
          <button class="chip" type="button" data-filter="competiteurs">Compétiteurs</button>
          <button class="chip" type="button" data-filter="lady">Lady</button>
          <button class="chip" type="button" data-filter="educative">École</button>
          <button class="chip" type="button" data-filter="camp">Camp</button>
          <button class="chip" type="button" data-filter="pieds">Pieds-poings</button>
          <button class="chip" type="button" data-filter="libre">Accès libre</button>
        </div>
        <div class="plan-grid">
          <section class="plan-day"><header><span>Lundi</span></header><ul>
            <li data-disc="libre"><time>10h00–12h00</time><span>Accès libre</span><span>autonomie</span></li>
            <li data-disc="camp"><time>12h40–13h20</time><span>Boxing camp</span><span>adultes</span></li>
            <li data-disc="libre"><time>13h20–18h00</time><span>Accès libre</span><span>autonomie</span></li>
            <li data-disc="competiteurs"><time>18h00–19h30</time><span>Boxe compétiteurs</span><span>licenciés</span></li>
            <li data-disc="lady"><time>18h30–19h30</time><span>Boxing Lady</span><span>100 % féminin</span></li>
            <li data-disc="anglaise"><time>19h40–21h00</time><span>Boxe anglaise loisirs</span><span>tous niveaux</span></li>
          </ul></section>
          <section class="plan-day"><header><span>Mardi</span></header><ul>
            <li data-disc="libre"><time>10h00–12h00</time><span>Accès libre</span><span>autonomie</span></li>
            <li data-disc="anglaise"><time>12h40–13h20</time><span>Boxe anglaise loisirs</span><span>tous niveaux</span></li>
            <li data-disc="libre"><time>13h20–18h00</time><span>Accès libre</span><span>autonomie</span></li>
            <li data-disc="competiteurs"><time>18h00–19h30</time><span>Boxe compétiteurs</span><span>licenciés</span></li>
            <li data-disc="camp"><time>18h30–19h30</time><span>Boxing camp</span><span>adultes</span></li>
            <li data-disc="anglaise"><time>19h40–21h00</time><span>Boxe anglaise loisirs</span><span>tous niveaux</span></li>
          </ul></section>
          <section class="plan-day"><header><span>Mercredi</span></header><ul>
            <li data-disc="libre"><time>10h00–12h00</time><span>Accès libre</span><span>autonomie</span></li>
            <li data-disc="anglaise"><time>12h40–13h20</time><span>Boxe anglaise loisirs</span><span>tous niveaux</span></li>
            <li data-disc="educative"><time>15h00–16h00</time><span>Éducative enfants</span><span>7/11 ans</span></li>
            <li data-disc="educative"><time>16h00–17h00</time><span>Éducative ados</span><span>12/16 ans</span></li>
            <li data-disc="educative"><time>17h00–18h30</time><span>Jeunes compétiteurs</span><span>licenciés</span></li>
            <li data-disc="lady"><time>18h30–19h30</time><span>Boxing Lady</span><span>100 % féminin</span></li>
            <li data-disc="pieds"><time>19h40–21h00</time><span>Boxe pieds-poings</span><span>tous niveaux</span></li>
          </ul></section>
          <section class="plan-day"><header><span>Jeudi</span></header><ul>
            <li data-disc="libre"><time>10h00–12h00</time><span>Accès libre</span><span>autonomie</span></li>
            <li data-disc="anglaise"><time>12h40–13h20</time><span>Boxe anglaise loisirs</span><span>tous niveaux</span></li>
            <li data-disc="libre"><time>13h20–18h00</time><span>Accès libre</span><span>autonomie</span></li>
            <li data-disc="competiteurs"><time>18h00–19h30</time><span>Boxe compétiteurs</span><span>licenciés</span></li>
            <li data-disc="camp"><time>18h30–19h30</time><span>Boxing camp</span><span>adultes</span></li>
            <li data-disc="anglaise"><time>19h40–21h00</time><span>Boxe anglaise loisirs</span><span>tous niveaux</span></li>
          </ul></section>
          <section class="plan-day"><header><span>Vendredi</span></header><ul>
            <li data-disc="libre"><time>10h00–12h00</time><span>Accès libre</span><span>autonomie</span></li>
            <li data-disc="camp"><time>12h40–13h20</time><span>Boxing camp</span><span>adultes</span></li>
            <li data-disc="libre"><time>13h20–18h00</time><span>Accès libre</span><span>autonomie</span></li>
            <li data-disc="competiteurs"><time>18h00–19h30</time><span>Boxe compétiteurs</span><span>licenciés</span></li>
            <li data-disc="anglaise"><time>19h40–21h00</time><span>Boxe anglaise loisirs</span><span>tous niveaux</span></li>
          </ul></section>
          <section class="plan-day"><header><span>Samedi</span></header><ul>
            <li data-disc="libre"><time>10h00–12h00</time><span>Accès libre</span><span>autonomie</span></li>
            <li data-disc="camp"><time>11h00–12h00</time><span>Boxing camp</span><span>adultes</span></li>
            <li data-disc="libre"><time>12h40–14h00</time><span>Accès libre</span><span>autonomie</span></li>
            <li data-disc="educative"><time>14h15–15h00</time><span>Baby Boxe</span><span>3/6 ans</span></li>
            <li data-disc="educative"><time>15h00–16h00</time><span>Éducative enfants</span><span>7/11 ans</span></li>
            <li data-disc="educative"><time>16h00–17h00</time><span>Éducative ados</span><span>12/16 ans</span></li>
            <li data-disc="educative"><time>17h00–18h30</time><span>Jeunes compétiteurs</span><span>licenciés</span></li>
            <li data-disc="competiteurs"><time>18h30–19h30</time><span>Open sparring</span><span>licenciés</span></li>
            <li data-disc="libre"><time>19h40–21h00</time><span>Accès libre</span><span>autonomie</span></li>
          </ul></section>
        </div>
        <p class="note" style="margin-top:1.2rem">Ouvert 6 j/7, 10h–21h30. Fermé le dimanche.</p>
      </div>
    </section>
    <section class="cta-band">
      <div class="wrap">
        <h2>Venez tester un cours pour 10 €</h2>
        <p>Ou 4 semaines illimitées à 29 €. Inscription en ligne.</p>
        <p class="btn-row">
          <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/offre/29">Je m’inscris</a>
          <a class="btn" href="https://boutique.boxingcenter.fr/seance-essai">Essai 10 €</a>
        </p>
      </div>
    </section>
  </main>
</Base>
