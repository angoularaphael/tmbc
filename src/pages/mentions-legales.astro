---
import Base from '../layouts/Base.astro';
const title = 'Mentions légales — TMBC | Toulouse Minimes Boxing Club';
const description = 'Mentions légales de l’association Toulouse Minimes Boxing Club (TMBC), 10 rue de Fenouillet, 31200 Toulouse.';
const path = '/mentions-legales';
const preloadHero = false;
const jsonLd = undefined;
---
<Base title={title} description={description} path={path} preloadHero={preloadHero} jsonLd={jsonLd}>
<main id="main">
    <header class="phero">
      <img src="/assets/media/salle-plongee-1200.webp" alt="Salle de boxe TMBC vue de haut" width="1200" height="800" />
      <div class="wrap" data-reveal>
        <p class="eyebrow">Informations légales</p>
        <h1 class="display">Mentions légales</h1>
        <p class="lead">Association Toulouse Minimes Boxing Club (TMBC), 10 rue de Fenouillet, 31200 Toulouse.</p>
      </div>
    </header>
    <section class="section">
      <div class="wrap prose">
        <h2>Éditeur du site</h2>
        <p>Le site est édité par l’association sportive <strong>Toulouse Minimes Boxing Club</strong> (TMBC), 10 rue de Fenouillet, 31200 Toulouse.</p>
        <p>Courriel : <a href="mailto:bc.combat31@gmail.com">bc.combat31@gmail.com</a></p>
        <p>Directeur de la publication : le président de l’association.</p>

        <h2>Hébergement</h2>
        <p>Le site est hébergé par Vercel Inc., 440 N Barranca Avenue #4133, Covina, CA 91723, États-Unis.</p>

        <h2>Objet du site</h2>
        <p>Ce site présente l’association Toulouse Minimes Boxing Club (TMBC), la salle de boxe des Minimes, les cours de boxe anglaise et les modalités d’inscription. Les inscriptions en ligne se font via la boutique du club.</p>

        <h2>Propriété intellectuelle</h2>
        <p>Les textes, photographies, vidéos, marques et éléments graphiques présents sur ce site sont protégés. Toute reproduction non autorisée est interdite. Le nom et les signes TMBC et Toulouse Minimes Boxing Club appartiennent à l’association.</p>

        <h2>Liens hypertextes</h2>
        <p>Le site contient des liens vers <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">Boxing Center Minimes</a> et <a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a>. TMBC n’est pas responsable du contenu de ces sites tiers.</p>

        <h2>Données personnelles</h2>
        <p>Pour toute question : <a href="mailto:bc.combat31@gmail.com">bc.combat31@gmail.com</a>. Les messages ne sont pas cédés à des tiers.</p>
        <p>Ce site n’utilise pas de cookies publicitaires.</p>

        <h2>Crédit photographique</h2>
        <p>Les visuels de la salle et des cours illustrent l’activité du Toulouse Minimes Boxing Club.</p>
      </div>
    </section>
  </main>
</Base>
