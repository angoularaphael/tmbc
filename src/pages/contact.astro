---
import Base from "../layouts/Base.astro";
import { KEYWORDS } from "../data/site.js";

const faq = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Je n’ai jamais boxé. Je peux venir dans un club de boxe à Toulouse ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Oui. Au TMBC (club de boxe Toulouse Minimes), les créneaux débutants, le Boxing camp et le cardio boxing n’exigent aucun niveau. L’essai est à 10 €, matériel prêté.",
      },
    },
    {
      "@type": "Question",
      name: "Où se trouve la salle de boxe TMBC à Toulouse ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "12 rue de Fenouillet, 31200 Toulouse, quartier Minimes / Barrière de Paris. Métro ligne B, station Barrière de Paris, 3 minutes à pied.",
      },
    },
    {
      "@type": "Question",
      name: "Y a-t-il des cours de boxe pour les enfants à Toulouse ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Oui, dès 3 ans : Baby Boxe 3/6, éducative 7/11, ados 12/16, puis compétiteurs. 250 € l’année pour la Baby Boxe, 295 € au-delà, t-shirt inclus.",
      },
    },
    {
      "@type": "Question",
      name: "Y a-t-il un cours de boxe femme à Toulouse ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Le Boxing Lady est 100 % féminin : lundi et mercredi 18h30 au club de boxe des Minimes. Tous les autres cours sont mixtes.",
      },
    },
  ],
});
---
<Base
  title="Club de boxe Toulouse Minimes — adresse, métro, contact | TMBC"
  description="Club de boxe à Toulouse Minimes : 12 rue de Fenouillet 31200. Métro B Barrière de Paris, 3 min. Tél. 05 62 24 46 82. Lun–sam 10h–21h30."
  keywords={KEYWORDS.contact}
  current="contact"
  crumbs={[
    { name: "Accueil", href: "/" },
    { name: "Contact et accès", href: "/contact/" },
  ]}
>
  <script type="application/ld+json" slot="head" set:html={faq} />
  <main id="main">
<header class="page-hero" data-round-id="01">
      <img src="/assets/media/hero-ring.webp" alt="Ring de boxe" width="1200" height="800" />
      <div class="wrap" data-reveal>
        <p class="kicker">Salle de boxe Barrière de Paris</p>
        <h1 class="display" data-punch>Trois minutes du métro.</h1>
        <p class="lede">Contact du club de boxe TMBC à Toulouse Minimes. 12 rue de Fenouillet, 31200 Toulouse. Téléphone 05 62 24 46 82. Métro B Barrière de Paris, 3 min à pied.</p>
        <p class="btn-row">
          <a class="btn bell" href="tel:+33562244682"><span>Appeler la salle</span></a>
          <a class="btn btn--ghost" href="https://boutique.boxingcenter.fr/offre/259"><span>Saison · 259 €</span></a>
          <a class="btn btn--ghost" href="https://www.google.com/maps/dir/?api=1&destination=12+rue+de+Fenouillet+31200+Toulouse" target="_blank" rel="noopener"><span>Itinéraire</span></a>
        </p>
      </div>
    </header>

    <section class="section" data-round-id="02">
      <div class="wrap split">
        <div data-reveal>
          <p class="kicker">Accès</p>
          <ul class="list-check">
            <li>Métro ligne B — station Barrière de Paris (3 min à pied)</li>
            <li>Rocade sortie 31, direction Les Minimes</li>
            <li>Bus 70 / 27 — arrêt Minimes-Roquelaine</li>
            <li>Quartiers : Minimes, Lalande, Borderouge, Bonnefoy, Sept Deniers, Aucamville, Launaguet</li>
          </ul>
          <p><strong>Horaires</strong><br>Lundi–samedi 10h00–21h30<br>Dimanche fermé</p>
          <p>GPS 43.6256, 1.4309</p>
        </div>
        <iframe class="map-frame" title="Carte — 12 rue de Fenouillet, Toulouse" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://maps.google.com/maps?q=12%20rue%20de%20Fenouillet%2031200%20Toulouse&z=16&output=embed"></iframe>
      </div>
    </section>

    <section class="section section--steel" data-round-id="03">
      <div class="wrap split">
        <div data-reveal>
          <p class="kicker">Écrire au club</p>
          <h2 class="display">Une question avant de <span class="tint">venir.</span></h2>
          <p class="lede">Pas de formulaire : on répond plus vite au téléphone, à l’accueil, ou par mail. Lun–sam 10h–21h30.</p>
        </div>
        <div class="contact-panel" data-reveal>
          <p>Le plus simple, c’est d’appeler la salle. On vous dit le créneau, on prête les gants, on vous attend.</p>
          <p><strong>Téléphone</strong><br><a href="tel:+33562244682">05 62 24 46 82</a></p>
          <p><strong>E-mail</strong><br><a href="mailto:boxingcenter31@gmail.com">boxingcenter31@gmail.com</a></p>
          <p><strong>Adresse</strong><br>12 rue de Fenouillet, 31200 Toulouse<br>Métro B Barrière de Paris · 3 min à pied</p>
          <p class="btn-row">
            <a class="btn bell" href="tel:+33562244682"><span>Appeler</span></a>
            <a class="btn btn--ghost" href="mailto:boxingcenter31@gmail.com"><span>Écrire</span></a>
            <a class="btn btn--ghost" href="https://www.google.com/maps/dir/?api=1&destination=12+rue+de+Fenouillet+31200+Toulouse" target="_blank" rel="noopener"><span>Itinéraire</span></a>
          </p>
        </div>
      </div>
    </section>

    <section class="section" data-round-id="04">
      <div class="wrap faq">
        <p class="kicker">Questions du vestiaire</p>
        <h2 class="display">FAQ</h2>
        <details open>
          <summary>Je n’ai jamais boxé. Je peux venir ?</summary>
          <p>Oui. Créneaux débutants, Boxing camp, cardio boxing sans aucun coup reçu. L’essai est à 10 €, matériel prêté.</p>
        </details>
        <details>
          <summary>Quelle est la spécialité de la salle ?</summary>
          <p>La boxe anglaise. C’est la salle historique du groupe, le berceau de plusieurs boxeurs professionnels et amateurs — avec plusieurs rings dédiés.</p>
        </details>
        <details>
          <summary>Y a-t-il des cours pour les enfants ?</summary>
          <p>Oui, dès 3 ans : Baby Boxe 3/6, éducative 7/11, ados 12/16, puis compétiteurs. 250 € l’année pour la Baby Boxe, 295 € au-delà, t-shirt inclus.</p>
        </details>
        <details>
          <summary>Il y a des cours pour les femmes ?</summary>
          <p>Le Boxing Lady est 100 % féminin : lundi et mercredi 18h30. Tous les autres cours sont mixtes et ouverts.</p>
        </details>
        <details>
          <summary>On m’oblige à sparrer ?</summary>
          <p>Non. Personne ne monte sur le ring sans l’avoir demandé. Le seul sparring hebdomadaire est l’open sparring du samedi 18h30, entre licenciés compétiteurs.</p>
        </details>
      </div>
    </section>

    <section class="section section--steel seo-local" aria-labelledby="seo-contact">
      <div class="wrap prose">
        <h2 id="seo-contact">Comment venir au club de boxe de Toulouse Minimes</h2>
        <p>Le TMBC, <strong>club de boxe à Toulouse</strong>, se trouve au <strong>12 rue de Fenouillet, 31200 Toulouse</strong>, quartier Minimes / Barrière de Paris. Station : <strong>métro B Barrière de Paris</strong> (3 minutes à pied). Rocade : sortie 31, direction Les Minimes. Bus 70 et 27, arrêt Minimes-Roquelaine. GPS 43.6256, 1.4309.</p>
        <p>Horaires de la <strong>salle de boxe</strong> : <strong>lundi au samedi, 10h00–21h30</strong>. Dimanche fermé. Pour une première séance, arriver un quart d’heure avant et dire que c’est une première. Essai 10 €, offre 4 semaines 29 €, saison 259 €. Téléphone : <a href="tel:+33562244682">05 62 24 46 82</a>.</p>
        <p>Le club dessert Toulouse nord : Les Minimes, Barrière de Paris, Lalande, Borderouge, Bonnefoy, Sept Deniers, Aucamville et Launaguet. <a href="/planning-tarifs/">Voir le planning et les tarifs</a>.</p>
      </div>
    </section>
  </main>

</Base>
