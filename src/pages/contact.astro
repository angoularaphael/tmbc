---
import Base from '../layouts/Base.astro';
const title = 'Contact & accès — TMBC | 12 rue de Fenouillet, Toulouse';
const description = 'TMBC, 12 rue de Fenouillet 31200 Toulouse. Métro B Barrière de Paris (3 min). Tél. 05 62 24 46 82.';
const path = '/contact';
const preloadHero = false;
const jsonLd = undefined;
---
<Base title={title} description={description} path={path} preloadHero={preloadHero} jsonLd={jsonLd}>
<main id="main">
    <header class="phero">
      <img src="/assets/media/ring-tmbc-1200.webp" alt="Ring TMBC" width="1200" height="800" />
      <div class="wrap" data-reveal>
        <p class="eyebrow">12 rue de Fenouillet · 31200</p>
        <h1 class="display">Venez. 3 min du métro B.</h1>
        <p class="lead">12 rue de Fenouillet, 31200 Toulouse. Voir aussi <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">Boxing Center Minimes</a>. Ouvert lundi–samedi 10h–21h30.</p>
        <p class="btn-row" style="margin-top:1.2rem">
          <a class="btn btn--primary" href="tel:+33562244682">Appeler la salle</a>
          <a class="btn" href="https://www.google.com/maps/dir/?api=1&destination=12+rue+de+Fenouillet+31200+Toulouse" target="_blank" rel="noopener">Itinéraire</a>
        </p>
      </div>
    </header>
    <aside class="juice">
      <div class="wrap">
        <p>Accès à la <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">salle de boxe Toulouse Minimes</a>, réseau <a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a>.</p>
      </div>
    </aside>
    <section class="section">
      <div class="wrap split">
        <div data-reveal>
          <p class="eyebrow">Accès</p>
          <ul class="list-check">
            <li>Métro ligne B — station Barrière de Paris (3 min à pied)</li>
            <li>Rocade sortie 31, direction Les Minimes</li>
            <li>Bus 70 / 27 — arrêt Minimes-Roquelaine</li>
            <li>Minimes, Lalande, Borderouge, Bonnefoy, Sept Deniers, Aucamville, Launaguet</li>
          </ul>
          <p style="margin-top:1rem"><strong>Horaires</strong><br />Lundi–samedi 10h00–21h30<br />Dimanche fermé</p>
        </div>
        <iframe class="map-frame" title="Carte — 12 rue de Fenouillet, Toulouse" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://maps.google.com/maps?q=12%20rue%20de%20Fenouillet%2031200%20Toulouse&z=16&output=embed"></iframe>
      </div>
    </section>
    <section class="section band-tint">
      <div class="wrap split">
        <div data-reveal>
          <p class="eyebrow">Rappel</p>
          <h2 class="display" style="font-size:clamp(2rem,4.5vw,3.2rem)">Laissez vos coordonnées. <span class="tint">On vous rappelle.</span></h2>
          <form class="form" id="contact-form" style="margin-top:1.2rem">
            <label>Prénom <input name="prenom" required autocomplete="given-name" /></label>
            <label>Téléphone <input name="tel" type="tel" required autocomplete="tel" /></label>
            <label>E-mail <input name="email" type="email" required autocomplete="email" /></label>
            <label>Message <textarea name="msg" rows="4"></textarea></label>
            <button class="btn btn--primary" type="submit">Envoyer</button>
          </form>
          <div class="form-ok" id="form-ok" hidden>
            <p class="eyebrow">Message reçu</p>
            <p>Merci. Un mail s’ouvre vers boxingcentertls@gmail.com. Vous pouvez aussi appeler le 05 62 24 46 82.</p>
          </div>
        </div>
        <div class="faq" data-reveal>
          <p class="eyebrow">Questions fréquentes</p>
          <h2 class="display" style="font-size:clamp(1.8rem,4vw,2.8rem)">FAQ</h2>
          <details open><summary>Je n’ai jamais boxé. Je peux venir ?</summary><p>Oui. Créneaux débutants, Boxing camp, cardio boxing sans coup reçu. Essai 10 €.</p></details>
          <details><summary>Quelle est la spécialité ?</summary><p>La boxe anglaise. Salle historique du groupe, plusieurs rings dédiés.</p></details>
          <details><summary>Cours pour les enfants ?</summary><p>Oui, dès 3 ans. Baby Boxe 250 €, éducative 295 €, t-shirt inclus.</p></details>
          <details><summary>Cours pour les femmes ?</summary><p>Boxing Lady, lundi et mercredi 18h30. Les autres cours sont mixtes.</p></details>
          <details><summary>On m’oblige à sparrer ?</summary><p>Non. Le seul sparring est l’open du samedi 18h30, entre licenciés.</p></details>
          <details><summary>Combien coûte l’essai ?</summary><p>10 € la séance. Gants prêtés. Aucun dossier.</p></details>
          <details><summary>Quel matériel pour commencer ?</summary><p>Tenue de sport pour l’essai. Ensuite gants, bandes et protections à la boutique, retrait en salle.</p></details>
          <details><summary>Horaires ?</summary><p>Lundi–samedi 10h–21h30. Fermé dimanche. Métro B Barrière de Paris, 3 min.</p></details>
        </div>
      </div>
    </section>
  </main>
</Base>
