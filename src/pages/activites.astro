---
import Base from '../layouts/Base.astro';
const title = 'Activités — TMBC | Boxe anglaise, Lady, enfants, camp';
const description = 'Neuf disciplines TMBC : boxe anglaise, compétiteurs, éducative dès 3 ans, Boxing Lady, boxing camp, pieds-poings, PAOS, cross training, cardio boxing.';
const path = '/activites';
const preloadHero = false;
const jsonLd = undefined;
---
<Base title={title} description={description} path={path} preloadHero={preloadHero} jsonLd={jsonLd}>
<main id="main">
    <header class="phero">
      <img src="/assets/media/ring-principal-1200.webp" alt="Ring principal aux cordes rouges" width="1200" height="800" />
      <div class="wrap" data-reveal>
        <p class="eyebrow">9 activités</p>
        <h1 class="display">Choisissez votre créneau</h1>
        <p class="lead">Boxe anglaise, Lady, enfants, camp, compétiteurs. Détail des cours aussi sur <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">Boxing Center Minimes</a>. Aucun contact obligatoire. Essai 10 €.</p>
      </div>
    </header>
    <aside class="juice">
      <div class="wrap">
        <p>Les activités de la <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">salle de boxe Toulouse Minimes</a>, au sein du réseau <a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a>.</p>
      </div>
    </aside>
    <article class="section" id="anglaise"><div class="wrap split">
      <div data-reveal><p class="eyebrow">01 · 7 cours / semaine</p><h2 class="display" style="font-size:clamp(2rem,4.5vw,3.6rem)">Boxe <span class="tint">anglaise</span></h2><p class="lead" style="margin-top:1rem">Midi 12h40 (mar, mer, jeu). Soir 19h40 (lun, mar, jeu, ven). Tous niveaux. Gants prêtés à l’essai.</p></div>
      <div class="frame" data-reveal><img src="/assets/media/cours-assaut-1200.webp" alt="Cours d’anglaise" width="1200" height="800" loading="lazy" /></div>
    </div></article>
    <article class="section band-tint" id="competiteurs"><div class="wrap split">
      <div class="frame" data-reveal><img src="/assets/media/sparring-graff-1200.webp" alt="Sparring encadré" width="1200" height="800" loading="lazy" /></div>
      <div data-reveal><p class="eyebrow">02 · licenciés</p><h2 class="display" style="font-size:clamp(2rem,4.5vw,3.6rem)">Compéti<span class="tint">teurs</span></h2><p class="lead" style="margin-top:1rem">Lun, mar, jeu, ven 18h–19h30. Open sparring samedi 18h30 — le seul sparring de la semaine, entre licenciés.</p></div>
    </div></article>
    <article class="section" id="educative"><div class="wrap split">
      <div data-reveal><p class="eyebrow">03 · dès 3 ans</p><h2 class="display" style="font-size:clamp(2rem,4.5vw,3.6rem)">Boxe <span class="tint">éducative</span></h2><p class="lead" style="margin-top:1rem">Baby Boxe 250 € (3–6 ans), éducative 295 € (7–16 ans), t-shirt inclus. Aucun coup porté chez les petits.</p></div>
      <div class="frame" data-reveal><img src="/assets/media/ecole-medailles-1200.webp" alt="Jeunes du club" width="1200" height="800" loading="lazy" /></div>
    </div></article>
    <article class="section band-tint" id="lady"><div class="wrap split">
      <div class="frame" data-reveal><img src="/assets/media/lady-garde-1200.webp" alt="Boxing Lady" width="1200" height="800" loading="lazy" /></div>
      <div data-reveal><p class="eyebrow">04 · 100 % féminin</p><h2 class="display" style="font-size:clamp(2rem,4.5vw,3.6rem)">Boxing <span class="tint">Lady</span></h2><p class="lead" style="margin-top:1rem">Lundi et mercredi 18h30. Sac, technique, cardio. Un vrai cours de boxe, 100 % féminin.</p></div>
    </div></article>
    <article class="section" id="camp"><div class="wrap split">
      <div data-reveal><p class="eyebrow">05 · 5 créneaux / semaine</p><h2 class="display" style="font-size:clamp(2rem,4.5vw,3.6rem)">Boxing <span class="tint">camp</span></h2><p class="lead" style="margin-top:1rem">Aucune technique exigée. Idéal pour une première séance. Lun/ven 12h40, mar/jeu 18h30, samedi 11h.</p></div>
      <div class="frame" data-reveal><img src="/assets/media/jumps-groupe-1200.webp" alt="Groupe en préparation physique" width="1200" height="800" loading="lazy" /></div>
    </div></article>
    <article class="section band-tint" id="pieds"><div class="wrap split">
      <div class="frame" data-reveal><img src="/assets/media/pieds-poings-1200.webp" alt="Cours de boxe pieds-poings, travail aux paos" width="1200" height="800" loading="lazy" /></div>
      <div data-reveal>
        <p class="eyebrow">06 · 1 créneau</p>
        <h2 class="display" style="font-size:clamp(2rem,4.5vw,3.6rem)">Pieds-<span class="tint">poings</span></h2>
        <p class="lead" style="margin-top:1rem">Mercredi 19h40–21h00. Tous niveaux. Le seul créneau de la semaine. Kicks, paos, cardio — un vrai cours pieds-poings, pas du fitness.</p>
      </div>
    </div></article>
    <section class="section">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Sans créneau dédié</p>
        <h2 class="display" data-reveal style="font-size:clamp(2rem,4.5vw,3.4rem)">Cross, PAOS, cardio : <span class="tint">accès libre</span></h2>
        <div class="disc-grid" data-reveal-group>
          <article class="disc"><img src="/assets/media/pattes-ours-1200.webp" alt="Pattes d’ours" /><div class="disc__body"><span class="disc__n">07</span><h3>PAOS</h3><p>Dans le cours d’anglaise. Pas un cours à part.</p></div></article>
          <article class="disc"><img src="/assets/media/cross-rack-1200.webp" alt="Cross training" /><div class="disc__body"><span class="disc__n">08</span><h3>Cross training</h3><p>Étage, 10h–12h et 13h20–18h. Zéro contact.</p></div></article>
          <article class="disc"><img src="/assets/media/ballon-vitesse-1200.webp" alt="Cardio boxing" /><div class="disc__body"><span class="disc__n">09</span><h3>Cardio boxing</h3><p>Le geste, aucun coup reçu, sur les douze sacs.</p></div></article>
        </div>
      </div>
    </section>
    <section class="cta-band">
      <div class="wrap">
        <h2>Testez un cours pour 10 €</h2>
        <p>Ou 4 semaines illimitées à 29 €. Inscription en ligne.</p>
        <p class="btn-row">
          <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/offre/29">Je m’inscris</a>
          <a class="btn" href="https://boutique.boxingcenter.fr/seance-essai">Essai 10 €</a>
        </p>
      </div>
    </section>
  </main>
</Base>
