---
import Base from '../layouts/Base.astro';
const title = 'Activités — TMBC | Boxe anglaise loisirs, compétiteurs, enfants';
const description = 'Boxe anglaise aux Minimes : loisirs tous niveaux, compétiteurs licenciés, école dès 3 ans. Essai 10 €. 12 rue de Fenouillet, Toulouse.';
const path = '/activites';
const preloadHero = false;
const jsonLd = undefined;
---
<Base title={title} description={description} path={path} preloadHero={preloadHero} jsonLd={jsonLd}>
<main id="main">
    <header class="phero">
      <img src="/assets/media/ring-principal-1200.webp" alt="Ring principal aux cordes rouges" width="1200" height="800" />
      <div class="wrap" data-reveal>
        <p class="eyebrow">Boxe anglaise</p>
        <h1 class="display">Loisirs, compétiteurs, enfants</h1>
        <p class="lead">Trois portes d’entrée, une seule discipline. Détail des cours aussi sur <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">Boxing Center Minimes</a>. Essai 10 €.</p>
      </div>
    </header>
    <aside class="juice">
      <div class="wrap">
        <p>Les cours de boxe anglaise de la <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">salle de boxe Toulouse Minimes</a>, au sein du réseau <a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a>.</p>
      </div>
    </aside>
    <article class="section" id="loisirs"><div class="wrap split">
      <div data-reveal><p class="eyebrow">01 · tous niveaux</p><h2 class="display" style="font-size:clamp(2rem,4.5vw,3.6rem)">Boxe anglaise <span class="tint">loisirs</span></h2><p class="lead" style="margin-top:1rem">Midi 12h40 (mar, mer, jeu). Soir 19h40 (lun, mar, jeu, ven). Technique, sac, assauts maîtrisés. Personne ne vous met en opposition. Gants prêtés à l’essai.</p></div>
      <div class="frame" data-reveal><img src="/assets/media/cours-assaut-1200.webp" alt="Cours de boxe anglaise loisirs" width="1200" height="800" loading="lazy" /></div>
    </div></article>
    <article class="section band-tint" id="competiteurs"><div class="wrap split">
      <div class="frame" data-reveal><img src="/assets/media/sparring-graff-1200.webp" alt="Sparring encadré compétiteurs" width="1200" height="800" loading="lazy" /></div>
      <div data-reveal><p class="eyebrow">02 · licenciés</p><h2 class="display" style="font-size:clamp(2rem,4.5vw,3.6rem)">Boxe anglaise <span class="tint">compétiteurs</span></h2><p class="lead" style="margin-top:1rem">Lun, mar, jeu, ven 18h–19h30. Open sparring samedi 18h30 — le seul sparring de la semaine, entre licenciés.</p></div>
    </div></article>
    <article class="section" id="educative"><div class="wrap split">
      <div data-reveal><p class="eyebrow">03 · dès 3 ans</p><h2 class="display" style="font-size:clamp(2rem,4.5vw,3.6rem)">École de <span class="tint">boxe</span></h2><p class="lead" style="margin-top:1rem">Baby Boxe 250 € (3–6 ans), éducative 295 € (7–16 ans), t-shirt inclus. Mercredi et samedi. Aucun coup porté chez les petits.</p></div>
      <div class="frame" data-reveal><img src="/assets/media/ecole-medailles-1200.webp" alt="Jeunes du club" width="1200" height="800" loading="lazy" /></div>
    </div></article>
    <section class="cta-band">
      <div class="wrap">
        <h2>Testez un cours pour 10 €</h2>
        <p>Ou 4 semaines illimitées à 29 €. Inscription en ligne.</p>
        <p class="btn-row">
          <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/offre/29">Je m’inscris</a>
          <a class="btn" href="https://boutique.boxingcenter.fr/seance-essai">Essai 10 €</a>
        </p>
      </div>
    </section>
  </main>
</Base>
