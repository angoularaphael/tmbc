---
import Base from '../layouts/Base.astro';
const title = 'Club boxe Toulouse | Cours boxe anglaise | TMBC';
const description = 'Club boxe Toulouse : cours de boxe anglaise, boxe éducative filles et garçons, tarifs et horaires. Débutants, loisirs, compétiteurs. Essai 10 €, Minimes.';
const path = '/activites';
const preloadHero = false;
const jsonLd = undefined;
---
<Base title={title} description={description} path={path} preloadHero={preloadHero} jsonLd={jsonLd}>
<main id="main">
    <header class="phero">
      <img src="/assets/media/ring-principal-1200.webp" alt="Ring de boxe anglaise au TMBC Toulouse Minimes" width="1200" height="800" />
      <div class="wrap" data-reveal>
        <p class="eyebrow">Club boxe Toulouse · boxe anglaise</p>
        <h1 class="display">Club boxe Toulouse : débutants, loisirs, compétiteurs, enfants</h1>
        <p class="lead">Club boxe Toulouse aux Minimes : trois portes d’entrée, une seule discipline — la boxe anglaise. Débutant boxe bienvenu. Détail des cours aussi sur <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">Boxing Center Minimes</a>. Essai 10 €.</p>
      </div>
    </header>
    <aside class="juice">
      <div class="wrap">
        <p>Les cours de boxe anglaise loisirs, compétiteurs et école du Toulouse Minimes Boxing Club. Aussi sur <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">Boxing Center Minimes</a> et <a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a>.</p>
      </div>
    </aside>
    <article class="section" id="loisirs"><div class="wrap split">
      <div data-reveal><p class="eyebrow">01 · débutant boxe · loisirs · Toulouse</p><h2 class="display" style="font-size:clamp(2rem,4.5vw,3.6rem)">Boxe anglaise <span class="tint">loisirs</span></h2><p class="lead" style="margin-top:1rem">Cours de boxe débutant et loisirs au club de boxe anglaise Toulouse Minimes. Midi 12h40 (mar, mer, jeu). Soir 19h40 (lun, mar, jeu, ven). Technique, sac, assauts maîtrisés. Personne ne vous met en opposition. Gants prêtés à l’essai.</p></div>
      <div class="frame" data-reveal><img src="/assets/media/cours-boxe-loisirs-debutant-toulouse.webp" alt="Cours de boxe anglaise loisirs et débutant à Toulouse Minimes" width="1024" height="768" loading="lazy" /></div>
    </div></article>
    <article class="section band-tint" id="competiteurs"><div class="wrap split">
      <div class="frame" data-reveal><img src="/assets/media/boxe-anglaise-competiteurs-toulouse.webp" alt="Boxe anglaise compétiteurs à Toulouse, sparring encadré" width="1600" height="1086" loading="lazy" /></div>
      <div data-reveal><p class="eyebrow">02 · boxe anglaise compétiteurs · Toulouse</p><h2 class="display" style="font-size:clamp(2rem,4.5vw,3.6rem)">Boxe anglaise <span class="tint">compétiteurs</span></h2><p class="lead" style="margin-top:1rem">Entraînement de boxe anglaise compétiteurs à Toulouse. Lun, mar, jeu, ven 18h–19h30. Open sparring samedi 18h30 — le seul sparring de la semaine, entre licenciés.</p></div>
    </div></article>
    <article class="section" id="educative"><div class="wrap split">
      <div data-reveal><p class="eyebrow">03 · école de boxe anglaise · dès 3 ans</p><h2 class="display" style="font-size:clamp(2rem,4.5vw,3.6rem)">École de <span class="tint">boxe anglaise</span></h2><p class="lead" style="margin-top:1rem">École de boxe anglaise à Toulouse dès 3 ans. Baby Boxe 250 € (3–6 ans), éducative 295 € (7–16 ans), t-shirt inclus. Mercredi et samedi. Aucun coup porté chez les petits.</p></div>
      <div class="frame" data-reveal><img src="/assets/media/ecole-boxe-enfants-toulouse-tmbc.webp" alt="École de boxe anglaise enfants à Toulouse Minimes" width="768" height="1024" loading="lazy" /></div>
    </div></article>
    <section class="cta-band">
      <div class="wrap">
        <h2>Testez un cours de boxe, même débutant, pour 10 €</h2>
        <p>Ou 4 semaines illimitées à 29 € au club de boxe anglaise TMBC, club Toulouse Minimes.</p>
        <p class="btn-row">
          <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/offre/29">Je m’inscris</a>
          <a class="btn" href="https://boutique.boxingcenter.fr/seance-essai">Essai 10 €</a>
        </p>
      </div>
    </section>
  </main>
</Base>
