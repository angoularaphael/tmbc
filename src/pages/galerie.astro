---
import Base from '../layouts/Base.astro';
import folder2 from '../data/galerie-folder2.json';

const title = 'Galerie club boxe anglaise Toulouse | TMBC Minimes';
const description = 'Photos du club de boxe anglaise TMBC à Toulouse : débutants, loisirs, compétiteurs, école. Salle 12 rue de Fenouillet, Minimes.';
const pathName = '/galerie';
const preloadHero = false;
const jsonLd = undefined;

const shots = [
  { src: '/assets/media/galerie/cours-boxe-anglaise-toulouse-01.webp', zone: 'anglaise', alt: 'Cours de boxe anglaise à Toulouse Minimes' },
  { src: '/assets/media/galerie/club-boxe-toulouse-minimes-cours.webp', zone: 'anglaise', alt: 'Club de boxe Toulouse Minimes pendant un cours' },
  { src: '/assets/media/galerie/cours-boxe-toulouse-minimes.webp', zone: 'anglaise', alt: 'Cours de boxe au TMBC Toulouse Minimes' },
  { src: '/assets/media/galerie/cours-boxe-loisirs-toulouse-minimes.webp', zone: 'anglaise', alt: 'Cours de boxe loisirs à Toulouse Minimes' },
  { src: '/assets/media/galerie/boxe-debutant-toulouse-tmbc.webp', zone: 'anglaise', alt: 'Boxe débutant au club TMBC Toulouse' },
  { src: '/assets/media/galerie/entrainement-boxe-anglaise-toulouse.webp', zone: 'anglaise', alt: 'Entraînement de boxe anglaise à Toulouse' },
  { src: '/assets/media/galerie/cours-collectif-boxe-toulouse.webp', zone: 'anglaise', alt: 'Cours collectif de boxe à Toulouse' },
  { src: '/assets/media/galerie/assaut-boxe-anglaise-toulouse.webp', zone: 'anglaise', alt: 'Assaut de boxe anglaise au TMBC Toulouse' },
  { src: '/assets/media/galerie/club-boxe-toulouse-barriere-de-paris.webp', zone: 'anglaise', alt: 'Club de boxe Toulouse Barrière de Paris' },
  { src: '/assets/media/galerie/boxe-anglaise-toulouse-minimes.webp', zone: 'anglaise', alt: 'Boxe anglaise Toulouse Minimes' },
  { src: '/assets/media/galerie/cours-boxe-toulouse-rue-de-fenouillet.webp', zone: 'anglaise', alt: 'Cours de boxe, 12 rue de Fenouillet à Toulouse' },
  { src: '/assets/media/galerie/tmbc-cours-boxe-anglaise-toulouse.webp', zone: 'anglaise', alt: 'TMBC, cours de boxe anglaise à Toulouse' },
  { src: '/assets/media/galerie/salle-boxe-toulouse-minimes.webp', zone: 'salle', alt: 'Salle de boxe Toulouse Minimes' },
  { src: '/assets/media/galerie/coach-mehdi-tmbc-toulouse.webp', zone: 'salle', alt: 'Mehdi, coach de boxe anglaise TMBC Toulouse' },
  { src: '/assets/media/galerie/salle-boxe-toulouse-500m2.webp', zone: 'salle', alt: 'Salle de boxe 500 m² à Toulouse Minimes' },
  { src: '/assets/media/galerie/salle-boxe-toulouse-ring.webp', zone: 'salle', alt: 'Ring de boxe à Toulouse Minimes' },
  { src: '/assets/media/galerie/salle-boxe-toulouse-barriere-de-paris.webp', zone: 'salle', alt: 'Salle de boxe Toulouse Barrière de Paris' },
  ...folder2,
];
---
<Base title={title} description={description} path={pathName} preloadHero={preloadHero} jsonLd={jsonLd}>
<main id="main">
    <div id="lightbox" role="dialog" aria-modal="true" aria-hidden="true" aria-label="Photo agrandie">
      <button class="lightbox__close" type="button">Fermer <span aria-hidden="true">✕</span></button>
      <img alt="" />
    </div>
    <header class="phero">
      <img src="/assets/media/galerie/salle-boxe-toulouse-barriere-de-paris.webp" alt="Salle de boxe Toulouse Barrière de Paris, TMBC Minimes" width="1600" height="1048" />
      <div class="wrap" data-reveal>
        <p class="eyebrow">Photos &amp; vidéo</p>
        <h1 class="display">Club de boxe anglaise à Toulouse, en images</h1>
        <p class="lead">Le club Toulouse Minimes. Cliquez pour agrandir. D’autres photos sur <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">Boxing Center Minimes</a>.</p>
      </div>
    </header>
    <aside class="juice">
      <div class="wrap">
        <p>La <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">salle de boxe Toulouse Minimes</a>, réseau <a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a>.</p>
      </div>
    </aside>
    <section class="section">
      <div class="wrap">
        <div class="filters" id="gal-filters">
          <button class="chip is-on" type="button" data-filter="all" aria-pressed="true">Tout</button>
          <button class="chip" type="button" data-filter="salle" aria-pressed="false">La salle</button>
          <button class="chip" type="button" data-filter="anglaise" aria-pressed="false">Anglaise</button>
        </div>
        <div class="gallery-grid" style="margin-top:1.6rem">
          {shots.map((shot, i) => (
            <button type="button" class="shot" data-zone={shot.zone} data-full={shot.src} aria-label={`Agrandir : ${shot.alt}`}>
              <img
                src={shot.src.replace('/galerie/', '/galerie/thumbs/')}
                alt={shot.alt}
                width="640"
                height="640"
                loading={i < 6 ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={i === 0 ? 'high' : 'low'}
              />
            </button>
          ))}
        </div>
      </div>
    </section>
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Vidéo</p>
        <h2 class="display" data-reveal style="font-size:clamp(2rem,4.5vw,3.4rem)">Gala de boxe <span class="tint">Boxing Center</span></h2>
        <div class="video-pocket" data-reveal style="margin-top:1.4rem">
          <video
            src="/assets/media/gala-boxe-toulouse-2023.mp4"
            poster="/assets/media/gala-boxe-toulouse-2023.webp"
            width="1280"
            height="720"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Gala de boxe le 30 mai 2023, Boxing Center Toulouse"
          ></video>
        </div>
      </div>
    </section>
    <section class="cta-band">
      <div class="wrap">
        <h2>Venez voir la salle. Essai 10 €</h2>
        <p>Ou 4 semaines illimitées à 29 €. Inscription en ligne.</p>
        <p class="btn-row">
          <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/offre/29">Je m’inscris</a>
          <a class="btn" href="https://boutique.boxingcenter.fr/seance-essai">Essai 10 €</a>
        </p>
      </div>
    </section>
  </main>
</Base>
