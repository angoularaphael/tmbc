---
import Base from '../layouts/Base.astro';

const title = 'Galerie club boxe anglaise Toulouse | TMBC Minimes';
const description = 'Photos du club de boxe anglaise TMBC à Toulouse : débutants, loisirs, compétiteurs, école. Salle 12 rue de Fenouillet, Minimes.';
const pathName = '/galerie';
const preloadHero = false;
const jsonLd = undefined;

const shots = [
  { src: '/assets/media/galerie/galerie-cecile-018.webp', zone: 'anglaise', alt: 'Cours de boxe anglaise au TMBC Toulouse Minimes' },
  { src: '/assets/media/galerie/galerie-cecile-020.webp', zone: 'anglaise', alt: 'Cours de boxe anglaise au TMBC Toulouse Minimes' },
  { src: '/assets/media/galerie/galerie-cecile-155.webp', zone: 'anglaise', alt: 'Cours de boxe anglaise au TMBC Toulouse Minimes' },
  { src: '/assets/media/galerie/galerie-cecile-158.webp', zone: 'anglaise', alt: 'Cours de boxe anglaise loisirs au TMBC Toulouse Minimes' },
  { src: '/assets/media/galerie/galerie-cecile-161.webp', zone: 'anglaise', alt: 'Cours de boxe anglaise au TMBC Toulouse Minimes' },
  { src: '/assets/media/galerie/galerie-cecile-171.webp', zone: 'anglaise', alt: 'Cours de boxe anglaise au TMBC Toulouse Minimes' },
  { src: '/assets/media/galerie/galerie-cecile-181.webp', zone: 'anglaise', alt: 'Cours de boxe anglaise au TMBC Toulouse Minimes' },
  { src: '/assets/media/galerie/galerie-cecile-182.webp', zone: 'anglaise', alt: 'Cours de boxe anglaise au TMBC Toulouse Minimes' },
  { src: '/assets/media/galerie/galerie-cecile-183.webp', zone: 'anglaise', alt: 'Cours de boxe anglaise au TMBC Toulouse Minimes' },
  { src: '/assets/media/galerie/galerie-cecile-186.webp', zone: 'anglaise', alt: 'Cours de boxe anglaise au TMBC Toulouse Minimes' },
  { src: '/assets/media/galerie/galerie-cecile-193.webp', zone: 'anglaise', alt: 'Cours de boxe anglaise au TMBC Toulouse Minimes' },
  { src: '/assets/media/galerie/galerie-cecile-201.webp', zone: 'anglaise', alt: 'Cours de boxe anglaise au TMBC Toulouse Minimes' },
  { src: '/assets/media/galerie/galerie-mardi-012.webp', zone: 'salle', alt: 'Salle de boxe TMBC, 12 rue de Fenouillet à Toulouse Minimes' },
  { src: '/assets/media/galerie/galerie-mardi-013.webp', zone: 'salle', alt: 'Mehdi, coach principal TMBC Toulouse Minimes' },
  { src: '/assets/media/galerie/galerie-mardi-075.webp', zone: 'salle', alt: 'Salle de boxe TMBC, 12 rue de Fenouillet à Toulouse Minimes' },
  { src: '/assets/media/galerie/galerie-mardi-077.webp', zone: 'salle', alt: 'Salle de boxe TMBC, 12 rue de Fenouillet à Toulouse Minimes' },
  { src: '/assets/media/galerie/galerie-mardi-080.webp', zone: 'salle', alt: 'Salle de boxe TMBC, 12 rue de Fenouillet à Toulouse Minimes' },
];
---
<Base title={title} description={description} path={pathName} preloadHero={preloadHero} jsonLd={jsonLd}>
<main id="main">
    <div id="lightbox" aria-hidden="true"><img alt="" /></div>
    <header class="phero">
      <img src="/assets/media/galerie/galerie-mardi-080.webp" alt="Salle de boxe TMBC Toulouse Minimes" width="1600" height="1048" />
      <div class="wrap" data-reveal>
        <p class="eyebrow">Photos &amp; vidéo</p>
        <h1 class="display">Club de boxe anglaise à Toulouse, en images</h1>
        <p class="lead">Le club Toulouse Minimes. Cliquez pour agrandir. D’autres photos sur <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">Boxing Center Minimes</a>.</p>
      </div>
    </header>
    <aside class="juice">
      <div class="wrap">
        <p>La <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">salle de boxe Toulouse Minimes</a>, réseau <a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a>.</p>
      </div>
    </aside>
    <section class="section">
      <div class="wrap">
        <div class="filters" id="gal-filters">
          <button class="chip is-on" type="button" data-filter="all" aria-pressed="true">Tout</button>
          <button class="chip" type="button" data-filter="salle" aria-pressed="false">La salle</button>
          <button class="chip" type="button" data-filter="anglaise" aria-pressed="false">Anglaise</button>
        </div>
        <div class="gallery-grid" style="margin-top:1.6rem">
          {shots.map((shot) => (
            <a class="shot" data-zone={shot.zone} data-full={shot.src} href={shot.src}>
              <img src={shot.src} alt={shot.alt} loading="lazy" />
            </a>
          ))}
        </div>
      </div>
    </section>
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Vidéo</p>
        <h2 class="display" data-reveal style="font-size:clamp(2rem,4.5vw,3.4rem)">Un extrait de <span class="tint">cours</span></h2>
        <div class="video-pocket" data-reveal style="margin-top:1.4rem">
          <video src="/assets/media/clip-sparring.mp4" muted loop playsinline preload="none" poster="/assets/media/galerie/galerie-cecile-158.webp"></video>
        </div>
      </div>
    </section>
    <section class="cta-band">
      <div class="wrap">
        <h2>Venez voir la salle. Essai 10 €</h2>
        <p>Ou 4 semaines illimitées à 29 €. Inscription en ligne.</p>
        <p class="btn-row">
          <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/offre/29">Je m’inscris</a>
          <a class="btn" href="https://boutique.boxingcenter.fr/seance-essai">Essai 10 €</a>
        </p>
      </div>
    </section>
  </main>
</Base>
