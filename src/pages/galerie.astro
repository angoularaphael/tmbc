---
import Base from "../layouts/Base.astro";
import { KEYWORDS } from "../data/site.js";
---
<Base
  title="Photos club de boxe Toulouse Minimes | Galerie TMBC"
  description="Galerie du club de boxe TMBC à Toulouse : ring, sacs, Boxing Lady, école, sparring. Photos d’une salle de boxe aux Minimes / Boxing Center."
  keywords={KEYWORDS.galerie}
  current="galerie"
  crumbs={[
    { name: "Accueil", href: "/" },
    { name: "Galerie", href: "/galerie/" },
  ]}
>
  <main id="main">
<header class="page-hero" data-round-id="01">
      <img src="/assets/media/sparring-ados-700.webp" alt="Sparring encadré avec casques" width="700" height="466" />
      <div class="wrap" data-reveal>
        <p class="kicker">Club de boxe Toulouse — en images</p>
        <h1 class="display" data-punch>Ce que la salle montre.</h1>
        <p class="lede">Photos et vidéo du club de boxe TMBC à Toulouse : ring, sacs, Boxing Lady, école, sparring, préparation physique. Images du pool Boxing Center / boxe-toulouse.com — pas encore un shooting certifié des Minimes.</p>
      </div>
    </header>

    <section class="section" data-round-id="02" aria-labelledby="t-gal-list">
      <div class="wrap">
        <h2 id="t-gal-list" class="display" style="margin-bottom:18px">Photos du club de boxe à Toulouse</h2>
        <p class="lede" style="margin-bottom:22px">Ring, allée des sacs, Boxing Lady, école, pattes d’ours, plateau de prépa. Cliquez une image pour l’agrandir.</p>
        <div class="filters" id="gal-filters" role="toolbar" aria-label="Filtrer la galerie">
          <button class="chip is-on" type="button" data-filter="all" aria-pressed="true">Tout</button>
          <button class="chip" type="button" data-filter="salle" aria-pressed="false">Salle</button>
          <button class="chip" type="button" data-filter="anglaise" aria-pressed="false">Anglaise</button>
          <button class="chip" type="button" data-filter="lady" aria-pressed="false">Lady</button>
          <button class="chip" type="button" data-filter="ecole" aria-pressed="false">École</button>
          <button class="chip" type="button" data-filter="technique" aria-pressed="false">Technique</button>
        </div>
        <div class="gallery-grid" data-stagger>
          <a class="shot" data-zone="salle" data-full="/assets/media/salle-plongee-1200.webp" href="/assets/media/salle-plongee-1200.webp">
            <img src="/assets/media/salle-plongee-1200.webp" alt="Vue plongeante sur le plateau" width="1200" height="800" loading="lazy" />
            <span class="tape">Salle</span>
          </a>
          <a class="shot" data-zone="salle" data-full="/assets/media/ring-principal-1200.webp" href="/assets/media/ring-principal-1200.webp">
            <img src="/assets/media/ring-principal-1200.webp" alt="Ring aux cordes rouges" width="1200" height="800" loading="lazy" />
            <span class="tape">Ring</span>
          </a>
          <a class="shot" data-zone="salle" data-full="/assets/media/allee-sacs-1200.webp" href="/assets/media/allee-sacs-1200.webp">
            <img src="/assets/media/allee-sacs-1200.webp" alt="Allée des sacs" width="1200" height="800" loading="lazy" />
            <span class="tape">Sacs</span>
          </a>
          <a class="shot" data-zone="anglaise" data-full="/assets/media/ring-cours-rouge-1200.webp" href="/assets/media/ring-cours-rouge-1200.webp">
            <img src="/assets/media/ring-cours-rouge-1200.webp" alt="Cours sur le ring" width="1200" height="800" loading="lazy" />
            <span class="tape">Cours</span>
          </a>
          <a class="shot" data-zone="technique" data-full="/assets/media/pattes-ours-1200.webp" href="/assets/media/pattes-ours-1200.webp">
            <img src="/assets/media/pattes-ours-1200.webp" alt="Pattes d’ours" width="1200" height="800" loading="lazy" />
            <span class="tape">PAOS</span>
          </a>
          <a class="shot" data-zone="anglaise" data-full="/assets/media/cours-collectif-700.webp" href="/assets/media/cours-collectif-700.webp">
            <img src="/assets/media/cours-collectif-700.webp" alt="Cours collectif" width="700" height="466" loading="lazy" />
            <span class="tape">Collectif</span>
          </a>
          <a class="shot" data-zone="lady" data-full="/assets/media/lady-garde-1200.webp" href="/assets/media/lady-garde-1200.webp">
            <img src="/assets/media/lady-garde-1200.webp" alt="Boxing Lady" width="1200" height="800" loading="lazy" />
            <span class="tape">Lady</span>
          </a>
          <a class="shot" data-zone="lady" data-full="/assets/media/coach-lady-1200.webp" href="/assets/media/coach-lady-1200.webp">
            <img src="/assets/media/coach-lady-1200.webp" alt="Coach et pratiquante en garde" width="1200" height="800" loading="lazy" />
            <span class="tape">Garde</span>
          </a>
          <a class="shot" data-zone="ecole" data-full="/assets/media/ecole-medailles-1200.webp" href="/assets/media/ecole-medailles-1200.webp">
            <img src="/assets/media/ecole-medailles-1200.webp" alt="École de boxe, médailles" width="1200" height="800" loading="lazy" />
            <span class="tape">École</span>
          </a>
          <a class="shot" data-zone="anglaise" data-full="/assets/media/sparring-ados-700.webp" href="/assets/media/sparring-ados-700.webp">
            <img src="/assets/media/sparring-ados-700.webp" alt="Sparring casqué" width="700" height="466" loading="lazy" />
            <span class="tape">Sparring</span>
          </a>
          <a class="shot" data-zone="technique" data-full="/assets/media/jumps-groupe-1200.webp" href="/assets/media/jumps-groupe-1200.webp">
            <img src="/assets/media/jumps-groupe-1200.webp" alt="Sauts sur box" width="1200" height="800" loading="lazy" />
            <span class="tape">Prépa</span>
          </a>
          <a class="shot" data-zone="salle" data-full="/assets/media/cross-rack-1200.webp" href="/assets/media/cross-rack-1200.webp">
            <img src="/assets/media/cross-rack-1200.webp" alt="Rack et barres" width="1200" height="800" loading="lazy" />
            <span class="tape">Étage</span>
          </a>
          <a class="shot" data-zone="technique" data-full="/assets/media/ballon-vitesse-1200.webp" href="/assets/media/ballon-vitesse-1200.webp">
            <img src="/assets/media/ballon-vitesse-1200.webp" alt="Ballon de vitesse" width="1200" height="800" loading="lazy" />
            <span class="tape">Vitesse</span>
          </a>
          <a class="shot" data-zone="anglaise" data-full="/assets/media/cours-assaut-1200.webp" href="/assets/media/cours-assaut-1200.webp">
            <img src="/assets/media/cours-assaut-1200.webp" alt="Travail d’assaut" width="1200" height="800" loading="lazy" />
            <span class="tape">Assaut</span>
          </a>
          <a class="shot" data-zone="salle" data-full="/assets/media/ring-tmbc-1200.webp" href="/assets/media/ring-tmbc-1200.webp">
            <img src="/assets/media/ring-tmbc-1200.webp" alt="Ring TMBC" width="1200" height="800" loading="lazy" />
            <span class="tape">TMBC</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section section--bleed" data-round-id="03" aria-labelledby="t-clip">
      <div class="video-pocket">
        <video src="/assets/media/clip-sparring.mp4" muted loop playsinline preload="metadata" poster="/assets/media/sparring-graff-1200.webp" aria-label="Clip de sparring encadré"></video>
        <span class="tape">Clip · sparring</span>
        <div class="video-pocket__copy">
          <h2 id="t-clip" class="display" style="font-size:clamp(1.8rem,4vw,3.2rem)">Le sparring, en images.</h2>
          <p>Extrait du pool Boxing Center. À TMBC, le sparring n’est pas une surprise : open sparring samedi 18h30, licenciés compétiteurs uniquement, casques et coach.</p>
        </div>
      </div>
    </section>

    <section class="section seo-local" aria-labelledby="seo-gal">
      <div class="wrap prose">
        <h2 id="seo-gal">Photos d’un club de boxe à Toulouse Minimes</h2>
        <p>Cette galerie montre l’ambiance d’une <strong>salle de boxe à Toulouse</strong> : ring, allée des sacs, Boxing Lady, école de boxe, sparring encadré. Les clichés viennent du pool public Boxing Center / boxe-toulouse.com. Le shooting dédié du <strong>club de boxe des Minimes</strong> n’a pas encore eu lieu.</p>
        <p>Pour visiter la <strong>salle de boxe</strong> en vrai : <a href="/contact/">12 rue de Fenouillet, métro B Barrière de Paris</a>. Pour les cours : <a href="/disciplines/">disciplines</a> et <a href="/planning-tarifs/">planning</a>.</p>
      </div>
    </section>
  </main>

  <div class="lightbox" id="lightbox" aria-hidden="true" role="dialog" aria-label="Photo agrandie">
    <button type="button" aria-label="Fermer">×</button>
    <img alt="" />
  </div>
</Base>
