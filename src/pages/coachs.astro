---
import Base from '../layouts/Base.astro';
const title = 'Coachs — TMBC | Mehdi, Chloé, David, Clément';
const description = 'Coachs diplômés TMBC : Mehdi, Chloé, David, Clément. Encadrement dès la première séance. Essai 10 €.';
const path = '/coachs';
const preloadHero = false;
const jsonLd = undefined;
---
<Base title={title} description={description} path={path} preloadHero={preloadHero} jsonLd={jsonLd}>
<main id="main">
    <header class="phero">
      <img src="/assets/media/coach-garde-v2-1200.webp" alt="Un coach corrige la garde d’un boxeur" width="1200" height="800" />
      <div class="wrap" data-reveal>
        <p class="eyebrow">4 coachs diplômés</p>
        <h1 class="display">Un coach dès votre première séance</h1>
        <p class="lead">Diplômés d’État, licenciés FFBoxe. Encadrement présenté aussi sur <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">Boxing Center Minimes</a>. Essai 10 €.</p>
      </div>
    </header>
    <aside class="juice">
      <div class="wrap">
        <p>Les coachs de la <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">salle de boxe Toulouse Minimes</a>, réseau <a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a>.</p>
      </div>
    </aside>
    <section class="section">
      <div class="wrap split">
        <div class="frame frame--coach" data-reveal><img src="/assets/media/coach-mehdi-photo.webp" alt="Mehdi Boutlelis, coach principal TMBC, dans le ring" width="768" height="512" /></div>
        <div data-reveal>
          <p class="eyebrow">Coach principal</p>
          <h2 class="display" style="font-size:clamp(2.2rem,5vw,4rem)">Mehdi</h2>
          <p class="lead" style="margin-top:1rem">Boxe anglaise, éducative, compétiteurs, Baby Boxe, boxing camp, open sparring. Du premier jab d’un débutant à la prep d’un gala.</p>
        </div>
      </div>
    </section>
    <section class="section band-tint">
      <div class="wrap">
        <div class="coachrow__grid" data-reveal-group>
          <article class="coachcard"><div class="coachcard__media"><img src="/assets/media/lady-garde-1200.webp" alt="Cours Boxing Lady" width="800" height="1000" loading="lazy" /></div><div class="coachcard__body"><p class="coachcard__tag">Boxing Lady</p><h3 class="coachcard__name">Chloé</h3><p class="coachcard__role">Lundi et mercredi 18h30</p></div></article>
          <article class="coachcard"><div class="coachcard__media"><img src="/assets/media/pieds-poings-1200.webp" alt="Cours pieds-poings" width="1200" height="800" loading="lazy" /></div><div class="coachcard__body"><p class="coachcard__tag">Lady · pieds-poings</p><h3 class="coachcard__name">David</h3><p class="coachcard__role">Mercredi soir, le créneau pieds-poings</p></div></article>
          <article class="coachcard"><div class="coachcard__media"><img src="/assets/media/jumps-groupe-1200.webp" alt="Boxing camp" width="800" height="1000" loading="lazy" /></div><div class="coachcard__body"><p class="coachcard__tag">Camp</p><h3 class="coachcard__name">Clément</h3><p class="coachcard__role">Boxing camp et cross training</p></div></article>
          <article class="coachcard"><div class="coachcard__media"><img src="/assets/media/coach-garde-v2-1200.webp" alt="Mehdi corrige une garde" loading="lazy" /></div><div class="coachcard__body"><p class="coachcard__tag">Staff</p><h3 class="coachcard__name">L’équipe</h3><p class="coachcard__role">Valentin Guth et Johnson en loisirs</p></div></article>
        </div>
      </div>
    </section>
    <section class="section">
      <div class="wrap split">
        <div data-reveal>
          <p class="eyebrow">Première séance</p>
          <h2 class="display" style="font-size:clamp(2rem,4.5vw,3.4rem)">Votre première séance, <span class="tint">pas à pas</span></h2>
          <ul class="list-check" style="margin-top:1rem">
            <li>Arriver un quart d’heure avant. Dire que c’est une première.</li>
            <li>Aucun dossier, aucun certificat pour l’essai.</li>
            <li>Gants prêtés. Échauffement, garde, jab, sac.</li>
            <li>Pas de sparring imposé. Rien à signer en sortant.</li>
          </ul>
          <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/seance-essai" style="margin-top:1.2rem">Réserver l’essai — 10 €</a>
        </div>
        <div class="frame" data-reveal><img src="/assets/media/pattes-ours-1200.webp" alt="Travail aux pattes d’ours" width="1200" height="800" loading="lazy" /></div>
      </div>
    </section>
    <section class="cta-band">
      <div class="wrap">
        <h2>4 semaines illimitées à 29 €</h2>
        <p>Toutes les activités. Sans engagement. Inscription en ligne.</p>
        <p class="btn-row">
          <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/offre/29">Je m’inscris</a>
          <a class="btn" href="https://boutique.boxingcenter.fr/seance-essai">Essai 10 €</a>
        </p>
      </div>
    </section>
  </main>
</Base>
