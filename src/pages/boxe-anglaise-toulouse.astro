---
import Base from '../layouts/Base.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import SeoLinks from '../components/SeoLinks.astro';
import MaterielBand from '../components/MaterielBand.astro';

const title = 'Boxe anglaise Toulouse | Cours loisirs & compétiteurs | TMBC';
const description = 'Cours de boxe anglaise à Toulouse Minimes. Débutants, loisirs et compétiteurs. Essai 10 €, offre 29 €. 10 rue de Fenouillet, métro Barrière de Paris.';
const path = '/boxe-anglaise-toulouse';
const faq = [
  { q: 'Qu’est-ce que la boxe anglaise ?', a: 'Sport de boxe aux poings, avec gants. Technique de garde, déplacements, coups au sac et assauts maîtrisés. Pas de coups de pied.' },
  { q: 'Où faire de la boxe anglaise à Toulouse ?', a: 'Au TMBC, 10 rue de Fenouillet (Minimes). Cours loisirs, compétiteurs et école. Planning sur boxe-toulouse.com.' },
  { q: 'Faut-il une licence pour commencer ?', a: 'Non pour l’essai 10 €. Ensuite, licence FFBoxe incluse dans les formules club.' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<Base title={title} description={description} path={path} jsonLd={jsonLd}>
<main id="main">
  <header class="phero">
    <img src="/assets/media/cours-boxe-loisirs-debutant-toulouse.webp" alt="Cours boxe anglaise Toulouse Minimes" width="1024" height="768" />
    <div class="wrap" data-reveal>
      <p class="eyebrow">Boxe anglaise · Toulouse</p>
      <h1 class="display">Boxe anglaise à Toulouse — cours aux Minimes</h1>
      <p class="lead">Cours de boxe anglaise à Toulouse : loisirs, compétiteurs et école. Club TMBC, boxe anglaise uniquement — technique, sac, assauts encadrés. Essai 10 €.</p>
    </div>
  </header>
  <aside class="juice"><div class="wrap"><p>Boxe anglaise Toulouse Minimes. <a href="/activites">Toutes les activités</a> · <a href="/boxe-debutant-toulouse">Débutants</a> · <a href="https://boxe-toulouse.com/plannings/" target="_blank" rel="noopener">Planning</a> · <a href="https://boutique.boxingcenter.fr/" target="_blank" rel="noopener">gants de boxe</a>.</p></div></aside>
  <article class="section"><div class="wrap split">
    <div data-reveal><p class="eyebrow">Loisirs</p><h2 class="display" style="font-size:clamp(2rem,4.5vw,3.4rem)">Boxe anglaise <span class="tint">loisirs</span></h2><p class="lead" style="margin-top:1rem">Midi 12h40 (mar, mer, jeu) et soir 19h40 (lun, mar, jeu, ven). Technique, sac, assauts maîtrisés. Idéal pour débuter la boxe anglaise à Toulouse sans opposition imposée.</p></div>
    <div class="frame" data-reveal><img src="/assets/media/cours-boxe-loisirs-debutant-toulouse.webp" alt="Boxe anglaise loisirs Toulouse" width="1024" height="768" loading="lazy" /></div>
  </div></article>
  <article class="section band-tint"><div class="wrap split">
    <div class="frame" data-reveal><img src="/assets/media/boxe-anglaise-competiteurs-toulouse.webp" alt="Boxe anglaise compétiteurs Toulouse" width="1600" height="1086" loading="lazy" /></div>
    <div data-reveal><p class="eyebrow">Compétiteurs</p><h2 class="display" style="font-size:clamp(2rem,4.5vw,3.4rem)">Boxe anglaise <span class="tint">compétiteurs</span></h2><p class="lead" style="margin-top:1rem">Lun, mar, jeu, ven 18h–19h30. Open sparring samedi 18h30 — le seul sparring de la semaine, entre licenciés du cours compétiteurs.</p></div>
  </div></article>
  <article class="section"><div class="wrap split">
    <div data-reveal><p class="eyebrow">École</p><h2 class="display" style="font-size:clamp(2rem,4.5vw,3.4rem)">École de <span class="tint">boxe anglaise</span></h2><p class="lead" style="margin-top:1rem">Dès 3 ans : Baby Boxe et boxe éducative. Mercredi et samedi. <a href="/boxe-enfants-toulouse">Boxe enfants Toulouse</a>.</p></div>
    <div class="frame" data-reveal><img src="/assets/media/ecole-boxe-enfants-toulouse-tmbc.webp" alt="École boxe anglaise enfants Toulouse" width="768" height="1024" loading="lazy" /></div>
  </div></article>
  <FaqList items={faq} title="Boxe anglaise Toulouse — FAQ" />
  <MaterielBand />
  <SeoLinks />
  <CtaBand />
</main>
</Base>
