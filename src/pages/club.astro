---
import Base from '../layouts/Base.astro';
const title = 'Club boxe Toulouse | Salle Minimes | TMBC FFBoxe';
const description = 'Club boxe Toulouse, 10 rue de Fenouillet (31200). Plan d’accès Barrière de Paris, horaires lun–sam 10h–21h30, photos de la salle. Affiliation FFBoxe.';
const path = '/club';
const preloadHero = false;
const jsonLd = undefined;
---
<Base title={title} description={description} path={path} preloadHero={preloadHero} jsonLd={jsonLd}>
<main id="main">
    <header class="phero">
      <img src="/assets/media/hero-club-boxe-toulouse-minimes.webp" alt="Salle de boxe anglaise TMBC à Toulouse Minimes pendant un cours" width="1024" height="768" />
      <div class="wrap" data-reveal>
        <p class="eyebrow">Club boxe Toulouse · depuis 2017</p>
        <h1 class="display">Club boxe Toulouse, aux Minimes</h1>
        <p class="lead">Club boxe Toulouse — boxe anglaise, 10 rue de Fenouillet. Ouvert aux débutants, 6 j/7. Toulouse Minimes Boxing Club (TMBC), ouvert en 2016. Planning des cours, essai 10 €, offre 29 €.</p>
      </div>
    </header>
    <aside class="juice">
      <div class="wrap">
        <p>TMBC — Toulouse Minimes Boxing Club — est le club de boxe anglaise des Minimes. Sites partenaires : <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">Boxing Center Minimes</a> et <a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a>.</p>
      </div>
    </aside>
    <section class="section">
      <div class="wrap split">
        <div data-reveal>
          <p class="eyebrow">Chronologie</p>
          <h2 class="display" style="font-size:clamp(2rem,4.5vw,3.4rem)">2016 : la salle. 2017 : <span class="tint">l’association.</span></h2>
        </div>
        <div class="timeline" data-reveal>
          <article><p class="eyebrow">2016</p><p>Ouverture au 10 rue de Fenouillet. Accès six jours sur sept, plusieurs rings, boxe anglaise d’abord.</p></article>
          <article><p class="eyebrow">2017</p><p>L’association TMBC prend son nom. Le club s’ancre aux Minimes — Barrière de Paris.</p></article>
          <article><p class="eyebrow">2018</p><p>L’école de boxe décolle. Johnson Suffo et Salomon Kitoko passent professionnels.</p></article>
          <article><p class="eyebrow">Aujourd’hui</p><p>Trois boxeurs professionnels et une trentaine d’amateurs formés. Affiliation FFBoxe. Boxe anglaise : loisirs, compétiteurs, enfants.</p></article>
        </div>
      </div>
    </section>
    <section class="section band-tint">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Le plateau</p>
        <h2 class="display" data-reveal style="font-size:clamp(2rem,4.5vw,3.4rem)">Ce que vous trouvez <span class="tint">dans la salle</span></h2>
        <ul class="equip" data-reveal-group>
          <li>
            <strong>Plusieurs rings</strong>
            <p>Travail en petits groupes, sans attendre son tour.</p>
          </li>
          <li>
            <strong>Douze sacs lourds</strong>
            <p>Et une zone pattes d’ours dans le cours d’anglaise.</p>
          </li>
          <li>
            <strong>Prépa à l’étage</strong>
            <p>Rack, barres, cardio. Accès libre aux heures d’ouverture.</p>
          </li>
          <li>
            <strong>Vestiaires H / F</strong>
            <p>Séparés. On peut venir voir un cours sans rien demander.</p>
          </li>
          <li>
            <strong>Matériel prêté</strong>
            <p>Gants, casques et protections le temps de l’essai.</p>
          </li>
          <li>
            <strong>Accès libre</strong>
            <p>Rings et sacs en autonomie, du lundi au samedi.</p>
          </li>
        </ul>
      </div>
    </section>
    <section class="section">
      <div class="wrap split">
        <div class="frame" data-reveal>
          <img src="/assets/media/ring-principal-1200.webp" alt="Ring principal aux cordes rouges" width="1200" height="800" loading="lazy" />
        </div>
        <div data-reveal>
          <p class="eyebrow">500 m²</p>
          <h2 class="display" style="font-size:clamp(2rem,4.5vw,3.4rem)">Plusieurs rings. 12 sacs. <span class="tint">Prépa à l’étage.</span></h2>
          <p class="lead" style="margin-top:1rem">Vestiaires H/F. Matériel prêté à l’essai. Accès libre hors cours, du lundi au samedi.</p>
          <p class="btn-row" style="margin-top:1.4rem">
            <a class="btn btn--primary" href="/galerie">Voir la salle</a>
            <a class="btn" href="https://boxe-toulouse.com/plannings/" target="_blank" rel="noopener">Le planning</a>
          </p>
        </div>
      </div>
    </section>
    <section class="section band-tint">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Sites officiels</p>
        <h2 class="heading" data-reveal>Boxing Center Minimes, et Boxing Center</h2>
        <p class="lead" data-reveal style="max-width:56ch">Le TMBC est le Toulouse Minimes Boxing Club. Sites partenaires :</p>
        <ul class="partner-list" data-reveal>
          <li><a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">Boxing Center Minimes</a></li>
          <li><a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a></li>
          <li><a href="https://materiel-de-boxe.fr/" target="_blank" rel="noopener">matériel de boxe</a></li>
          <li><a href="https://materiel-de-boxe.fr/boutique-boxe-toulouse" target="_blank" rel="noopener">matériel de boxe Toulouse</a></li>
        </ul>
        <p class="btn-row" style="margin-top:1.3rem" data-reveal>
          <a class="btn btn--primary" href="https://boxe-toulouse.com/" target="_blank" rel="noopener">Boxing Center Minimes</a>
          <a class="btn" href="https://materiel-de-boxe.fr/" target="_blank" rel="noopener">matériel de boxe</a>
        </p>
      </div>
    </section>
    <section class="cta-band">
      <div class="wrap">
        <h2>4 semaines illimitées à 29 €</h2>
        <p>Boxe anglaise. Sans engagement. Inscription en ligne.</p>
        <p class="btn-row">
          <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/offre/29">Je m’inscris</a>
          <a class="btn" href="https://boutique.boxingcenter.fr/seance-essai">Essai 10 €</a>
        </p>
      </div>
    </section>
  </main>
</Base>
