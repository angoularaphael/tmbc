---
import Base from '../layouts/Base.astro';
const title = 'TMBC — Toulouse Minimes Boxing Club | Boxe à Toulouse Minimes';
const description = 'Toulouse Minimes Boxing Club, 12 rue de Fenouillet. Essai 10 €, 4 semaines illimitées à 29 €, saison 259 €. Métro B Barrière de Paris, 3 min.';
const path = '/';
const preloadHero = true;
const jsonLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Je n’ai jamais boxé. Je peux venir ?", "acceptedAnswer": {"@type": "Answer", "text": "Oui. Boxing camp, cardio boxing, anglaise loisirs. Personne ne vous met en opposition. Essai 10 €, gants prêtés."}}, {"@type": "Question", "name": "Combien coûte l’essai ?", "acceptedAnswer": {"@type": "Answer", "text": "10 € la séance, toutes activités. Aucun dossier, aucun certificat. Gants et casque prêtés."}}, {"@type": "Question", "name": "C’est quoi l’offre 29 € ?", "acceptedAnswer": {"@type": "Answer", "text": "4 semaines illimitées, toutes les activités, 29 € par personne, sans engagement."}}, {"@type": "Question", "name": "On m’oblige à sparrer ?", "acceptedAnswer": {"@type": "Answer", "text": "Non. Le seul open sparring est le samedi 18h30, entre licenciés du cours compétiteurs."}}, {"@type": "Question", "name": "Il y a des cours enfants ?", "acceptedAnswer": {"@type": "Answer", "text": "Dès 3 ans. Baby Boxe 250 €, éducative 295 € l’année, t-shirt inclus."}}, {"@type": "Question", "name": "Où est la salle, et quels horaires ?", "acceptedAnswer": {"@type": "Answer", "text": "12 rue de Fenouillet, 31200 Toulouse. Métro B Barrière de Paris, 3 min. Lundi–samedi 10h–21h30."}}]};
---
<Base title={title} description={description} path={path} preloadHero={preloadHero} jsonLd={jsonLd}>
<main id="main">
    <header class="hero" aria-label="Toulouse Minimes Boxing Club">
      <img class="hero__bg" src="/assets/img/hero.png" width="1920" height="1080" alt="TMBC — salle de boxe Toulouse Minimes, depuis 2017" fetchpriority="high" />
      <div class="hero__veil"></div>
        <div class="hero__pitch">
        <p class="wordmark" aria-hidden="true"><span>T</span><span>M</span><span>B</span><span>C</span></p>
        <h1>Toulouse Minimes Boxing Club</h1>
        <p>Essai 10 €. Coach dès la première séance. Gants prêtés. Pas de sparring imposé.</p>
      </div>
      <div class="hero__foot">
        <ul class="hero__facts" data-reveal>
          <li class="hfact"><b>Essai 10 €</b><span>Une séance · gants prêtés</span></li>
          <li class="hfact"><b>4 semaines 29 €</b><span>Toutes activités, sans engagement</span></li>
          <li class="hfact"><b>Métro B · 3 min</b><span>Barrière de Paris</span></li>
        </ul>
        <p class="hero__cta" data-reveal>
          <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/offre/29">Je m’inscris — 29 €</a>
          <a class="btn" href="https://boutique.boxingcenter.fr/seance-essai">Réserver l’essai</a>
        </p>
      </div>
    </header>

    <aside class="dealbar">
      <div class="wrap">
        <p><b>4 semaines illimitées à 29 €</b><span>Offre rentrée · par personne · inscription en ligne</span></p>
        <p class="btn-row">
          <a class="btn" href="https://boutique.boxingcenter.fr/offre/29">Je m’inscris</a>
          <a class="btn btn--ghost" href="https://boutique.boxingcenter.fr/seance-essai">Essai 10 €</a>
        </p>
      </div>
    </aside>

    <div class="marquee" aria-hidden="true"><div class="marquee__track" id="marquee"></div></div>

    <aside class="juice">
      <div class="wrap">
        <p>TMBC est l’association de la <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">salle de boxe Toulouse Minimes</a> (Boxing Center Minimes). Le club appartient au réseau <a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a>.</p>
      </div>
    </aside>

    <section class="section">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Les formules</p>
        <h2 class="heading" data-reveal>Choisissez comment vous commencez</h2>
        <div class="offers" data-reveal-group style="margin-top:1.6rem">
          <article class="offer">
            <h3>Essai</h3>
            <b><span data-count="10">0</span> €</b>
            <p>Une séance pour voir si ça vous convient. Gants prêtés. Aucun dossier, aucun certificat.</p>
            <a class="btn" href="https://boutique.boxingcenter.fr/seance-essai">Réserver l’essai</a>
          </article>
          <article class="offer is-hot">
            <h3>Offre rentrée</h3>
            <b><s>44 €</s> <span data-count="29">0</span> €</b>
            <p>4 semaines, cours illimités, toutes les activités. 29 € par personne, sans engagement.</p>
            <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/offre/29">Je m’inscris</a>
          </article>
          <article class="offer">
            <h3>Saison</h3>
            <b><s>400 €</s> <span data-count="259">0</span> €</b>
            <p>12 mois, payable en 4× sans frais. Accès aux 5 salles du réseau <a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a>.</p>
            <a class="btn" href="https://boutique.boxingcenter.fr/offre/259">Prendre la saison</a>
          </article>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap split">
        <div data-reveal>
          <p class="eyebrow">Pourquoi TMBC</p>
          <h2 class="heading">Vous êtes encadré dès la première séance</h2>
          <p class="lead" style="margin-top:1rem">TMBC est l’association de la <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">salle de boxe Toulouse Minimes</a> — première salle du réseau <a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a>.</p>
          <ul class="why">
            <li><b>01</b> <span>Un coach diplômé vous place : pieds, garde, jab. Vous n’arrivez pas « dans le tas ».</span></li>
            <li><b>02</b> <span>Gants et casque prêtés à l’essai. Vous venez en tenue de sport.</span></li>
            <li><b>03</b> <span>Pas de sparring imposé. Le seul open est le samedi 18h30, entre licenciés.</span></li>
            <li><b>04</b> <span>3 minutes du métro B Barrière de Paris. Ouvert lundi–samedi 10h–21h30.</span></li>
          </ul>
          <p class="btn-row">
            <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/seance-essai">Réserver l’essai — 10 €</a>
            <a class="btn" href="/club">Voir la salle</a>
          </p>
        </div>
        <div class="frame" data-reveal>
          <img src="/assets/media/salle-plongee-1200.webp" alt="Plateau de boxe TMBC, sacs alignés sous la verrière" width="1200" height="800" />
          <span class="frame__tag">500 m² · 12 rue de Fenouillet</span>
        </div>
      </div>
    </section>

    <section class="section band-tint">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Pour qui</p>
        <h2 class="heading" data-reveal>Débutant, Lady ou enfant : une porte d’entrée claire</h2>
        <div class="doors" data-reveal-group style="margin-top:1.6rem">
          <a class="door" href="/activites#camp">
            <img src="/assets/media/jumps-groupe-1200.webp" alt="Cours de boxing camp" width="800" height="1000" loading="lazy" />
            <p class="eyebrow">Vous n’avez jamais boxé</p>
            <h3>Débutant</h3>
            <p>Boxing camp, cardio boxing, anglaise loisirs. Personne ne vous met en opposition.</p>
          </a>
          <a class="door" href="/activites#lady">
            <img src="/assets/media/lady-garde-1200.webp" alt="Cours Boxing Lady" width="800" height="1000" loading="lazy" />
            <p class="eyebrow">Lundi &amp; mercredi 18h30</p>
            <h3>Boxing Lady</h3>
            <p>Cours 100 % féminin. Technique, sac, cardio. Un vrai cours de boxe.</p>
          </a>
          <a class="door" href="/activites#educative">
            <img src="/assets/media/ecole-medailles-1200.webp" alt="École de boxe TMBC" width="800" height="1000" loading="lazy" />
            <p class="eyebrow">Dès 3 ans · t-shirt inclus</p>
            <h3>Enfants</h3>
            <p>Baby Boxe 250 €, éducative 295 €. Aucun coup porté chez les petits.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Les cours</p>
        <h2 class="heading" data-reveal>Les créneaux, sans jargon</h2>
        <div class="courses" style="margin-top:1.2rem">
          <a class="course" href="/activites#anglaise"><span class="course__n">01</span><div><h3>Boxe anglaise</h3><p>7 créneaux · midi 12h40 et soir 19h40 · tous niveaux</p></div><span>Voir →</span></a>
          <a class="course" href="/activites#lady"><span class="course__n">02</span><div><h3>Boxing Lady</h3><p>Lundi et mercredi 18h30 · 100 % féminin</p></div><span>Voir →</span></a>
          <a class="course" href="/activites#educative"><span class="course__n">03</span><div><h3>École dès 3 ans</h3><p>Mercredi et samedi · Baby, éducative, ados</p></div><span>Voir →</span></a>
          <a class="course" href="/activites#camp"><span class="course__n">04</span><div><h3>Boxing camp</h3><p>5 créneaux / semaine · aucune technique exigée</p></div><span>Voir →</span></a>
          <a class="course" href="/activites#competiteurs"><span class="course__n">05</span><div><h3>Compétiteurs</h3><p>Lun mar jeu ven 18h · open sparring samedi 18h30</p></div><span>Voir →</span></a>
          <a class="course" href="/activites#pieds"><span class="course__n">06</span><div><h3>Pieds-poings</h3><p>Mercredi 19h40 · un créneau, tous niveaux</p></div><span>Voir →</span></a>
        </div>
        <p class="btn-row" style="margin-top:1.4rem">
          <a class="btn btn--primary" href="/planning">Voir le planning</a>
          <a class="btn" href="/activites">Toutes les activités</a>
        </p>
      </div>
    </section>

    <section class="section band-tint">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Les coachs</p>
        <h2 class="heading" data-reveal>4 coachs diplômés. Vous n’êtes jamais seul sur le plateau.</h2>
        <div class="coachrow__grid" data-reveal-group>
          <article class="coachcard">
            <div class="coachcard__media"><img src="/assets/media/coach-mehdi-photo.webp" alt="Portrait de Mehdi, coach principal TMBC" width="768" height="512" loading="lazy" /></div>
            <div class="coachcard__body"><p class="coachcard__tag">Principal</p><h3 class="coachcard__name">Mehdi</h3><p class="coachcard__role">Anglaise, éducative, compétiteurs</p></div>
          </article>
          <article class="coachcard">
            <div class="coachcard__media"><img src="/assets/media/lady-garde-1200.webp" alt="Cours Boxing Lady aux Minimes" width="800" height="1000" loading="lazy" /></div>
            <div class="coachcard__body"><p class="coachcard__tag">Lady</p><h3 class="coachcard__name">Chloé</h3><p class="coachcard__role">Lundi et mercredi 18h30</p></div>
          </article>
          <article class="coachcard">
            <div class="coachcard__media"><img src="/assets/media/pieds-poings-1200.webp" alt="Cours pieds-poings aux Minimes" width="1200" height="800" loading="lazy" /></div>
            <div class="coachcard__body"><p class="coachcard__tag">Lady · pieds-poings</p><h3 class="coachcard__name">David</h3><p class="coachcard__role">Mercredi soir</p></div>
          </article>
          <article class="coachcard">
            <div class="coachcard__media"><img src="/assets/media/jumps-groupe-1200.webp" alt="Boxing camp TMBC" width="800" height="1000" loading="lazy" /></div>
            <div class="coachcard__body"><p class="coachcard__tag">Camp</p><h3 class="coachcard__name">Clément</h3><p class="coachcard__role">Boxing camp et cross</p></div>
          </article>
        </div>
        <p style="margin-top:1.6rem" data-reveal><a class="btn" href="/coachs">Voir les coachs</a></p>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Avis adhérents</p>
        <h2 class="heading" data-reveal>Ce que vous entendrez en vestiaire</h2>
        <div class="quotes" data-reveal-group style="margin-top:1.8rem">
          <blockquote>
            <p>« Je n’avais jamais fait de sport de combat. En trois séances, j’avais compris la garde et le direct. Personne ne se moque. »</p>
            <footer>Thomas L. · Boxe anglaise loisir</footer>
          </blockquote>
          <blockquote>
            <p>« Le cours Lady est ce qui m’a fait rester. On y travaille sérieusement, sans se sentir jugée. »</p>
            <footer>Sarah M. · Boxing Lady</footer>
          </blockquote>
          <blockquote>
            <p>« Mon fils y va depuis ses 6 ans. Il a gagné en confiance — et n’a jamais pris un coup qu’il n’avait pas choisi. »</p>
            <footer>Karim B. · Parent, boxe éducative</footer>
          </blockquote>
          <blockquote>
            <p>« Le camp du midi, 40 minutes, et je retourne au bureau. Mehdi corrige, personne ne juge. »</p>
            <footer>Léa P. · Boxing camp</footer>
          </blockquote>
          <blockquote>
            <p>« Très belle salle, matos au top, coachs et staff accueillants. On progresse dès la première semaine. »</p>
            <footer>Hamed S. · Anglaise</footer>
          </blockquote>
          <blockquote>
            <p>« Le créneau pieds-poings du mercredi est cash : kicks, paos, cardio. Un vrai cours, pas du fitness déguisé. »</p>
            <footer>Julien R. · Pieds-poings</footer>
          </blockquote>
        </div>
      </div>
    </section>

    <section class="section band-tint" id="boutique">
      <div class="wrap">
        <p class="eyebrow" data-reveal>La boutique</p>
        <h2 class="heading" data-reveal>Le matériel, le même qu’en salle</h2>
        <p class="lead" data-reveal>Gants, casque, bandes, protections. Commande en ligne, retrait aux Minimes.</p>
        <div class="shopgrid" data-reveal-group>
          <a class="shopcard" href="https://boutique.boxingcenter.fr/materiel/produit/gants-cuir-sparring-metal-boxe" target="_blank" rel="noopener">
            <img src="/assets/shop/gants.jpg" alt="Gants de sparring Metal Boxe 14 oz" width="400" height="400" loading="lazy" />
            <h3>Gants</h3>
            <p>Sparring cuir · Metal Boxe</p>
          </a>
          <a class="shopcard" href="https://boutique.boxingcenter.fr/materiel/produit/casque-d-entrainement-boxe-adulte-metal-boxe" target="_blank" rel="noopener">
            <img src="/assets/shop/casque.jpg" alt="Casque d’entraînement boxe adulte" width="400" height="400" loading="lazy" />
            <h3>Casque</h3>
            <p>Entraînement adulte</p>
          </a>
          <a class="shopcard" href="https://boutique.boxingcenter.fr/materiel/produit/bandes-de-boxe-4m-metal-boxe" target="_blank" rel="noopener">
            <img src="/assets/shop/bandes.jpg" alt="Bandes de boxe 4 mètres" width="400" height="400" loading="lazy" />
            <h3>Bandes</h3>
            <p>4 m · poignets tenus</p>
          </a>
          <a class="shopcard" href="https://boutique.boxingcenter.fr/materiel/produit/protege-dents-gel-metal-boxe" target="_blank" rel="noopener">
            <img src="/assets/shop/protege-dents.jpg" alt="Protège-dents gel" width="400" height="400" loading="lazy" />
            <h3>Protège-dents</h3>
            <p>Gel, moulé à chaud</p>
          </a>
          <a class="shopcard" href="https://boutique.boxingcenter.fr/materiel/produit/protege-tibias-pieds-blade-metal-boxe" target="_blank" rel="noopener">
            <img src="/assets/shop/protege-tibias.jpg" alt="Protège-tibias et pieds Blade" width="400" height="400" loading="lazy" />
            <h3>Protège-tibias</h3>
            <p>Pieds-poings · Blade</p>
          </a>
          <a class="shopcard" href="https://boutique.boxingcenter.fr/materiel/produit/short-boxe-thai-et-kick-boxing-noir-or-metal-boxe" target="_blank" rel="noopener">
            <img src="/assets/shop/short-thai.jpg" alt="Short de boxe thaï noir et or" width="400" height="400" loading="lazy" />
            <h3>Short thaï</h3>
            <p>Kick / pieds-poings</p>
          </a>
        </div>
        <p class="btn-row" style="margin-top:1.4rem" data-reveal>
          <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/materiel" target="_blank" rel="noopener">Toute la boutique</a>
        </p>
      </div>
    </section>

    <section class="section" id="faq">
      <div class="wrap home-faq">
        <p class="eyebrow" data-reveal>Questions fréquentes</p>
        <h2 class="heading" data-reveal>Avant de pousser la porte</h2>
        <div class="faq" style="margin-top:1.2rem">
          <details open><summary>Je n’ai jamais boxé. Je peux venir ?</summary><p>Oui. Boxing camp, cardio boxing, anglaise loisirs. Personne ne vous met en opposition. Essai 10 €, gants prêtés.</p></details>
          <details><summary>Combien coûte l’essai ?</summary><p>10 € la séance, toutes activités. Aucun dossier, aucun certificat. Gants et casque prêtés.</p></details>
          <details><summary>C’est quoi l’offre 29 € ?</summary><p>4 semaines illimitées, toutes les activités, 29 € par personne, sans engagement. Inscription en ligne.</p></details>
          <details><summary>On m’oblige à sparrer ?</summary><p>Non. Le seul open sparring est le samedi 18h30, entre licenciés du cours compétiteurs.</p></details>
          <details><summary>Il y a des cours enfants ?</summary><p>Dès 3 ans. Baby Boxe 250 €, éducative 295 € l’année, t-shirt inclus. Aucun coup porté chez les petits.</p></details>
          <details><summary>Et pour les femmes ?</summary><p>Boxing Lady, lundi et mercredi 18h30, 100 % féminin. Les autres cours sont mixtes.</p></details>
          <details><summary>Quel matériel faut-il ?</summary><p>Pour l’essai : tenue de sport et une bouteille d’eau. Ensuite, gants, bandes et protections se commandent à la boutique, retrait en salle.</p></details>
          <details><summary>Où est la salle, et quels horaires ?</summary><p>12 rue de Fenouillet, 31200 Toulouse. Métro B Barrière de Paris, 3 min. Lundi–samedi 10h–21h30. Fermé dimanche.</p></details>
        </div>
      </div>
    </section>

    <section class="section" id="reseau">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Sites officiels</p>
        <h2 class="heading" data-reveal>La salle Minimes, et le réseau</h2>
        <p class="lead" data-reveal>TMBC pointe vers les deux sites de référence. C’est là que se trouvent le planning officiel, les inscriptions et l’actualité du groupe.</p>
        <div class="netgrid netgrid--duo" data-reveal-group>
          <a class="netcard" href="https://boxe-toulouse.com/" target="_blank" rel="noopener">
            <span class="eyebrow">Minimes</span>
            <b>Boxing Center Minimes</b>
            <p>Le site officiel de la salle de boxe Toulouse Minimes : cours, planning, essai 10 €, offre 29 €.</p>
            <em>Voir le site →</em>
          </a>
          <a class="netcard" href="https://boxingcenter.fr/" target="_blank" rel="noopener">
            <span class="eyebrow">Le groupe</span>
            <b>Boxing Center</b>
            <p>Le site principal Boxing Center : les 5 salles, actualités, inscriptions et le réseau.</p>
            <em>Voir le site →</em>
          </a>
        </div>
      </div>
    </section>

    <section class="closer" aria-label="Inscription">
      <img data-parallax src="/assets/media/ring-principal-1200.webp" alt="Ring principal TMBC" width="1600" height="1000" />
      <div class="wrap">
        <p class="eyebrow">Inscription en ligne</p>
        <h2 class="display">4 semaines illimitées à 29 €</h2>
        <p class="lead">Toutes les activités. Sans engagement. Matériel prêté le temps de vous équiper.</p>
        <p class="btn-row" style="margin-top:1.4rem">
          <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/offre/29">Je m’inscris — 29 €</a>
          <a class="btn" href="tel:+33562244682">Appeler le 05 62 24 46 82</a>
        </p>
      </div>
    </section>
  </main>
</Base>
