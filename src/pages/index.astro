---
import Base from '../layouts/Base.astro';
const title = 'Club de boxe à Toulouse | Boxe anglaise Minimes | TMBC';
const description = 'Club de boxe à Toulouse (31) : boxe anglaise, boxe éducative filles et garçons, tarifs, horaires des cours, photos et plan d’accès. FFBoxe, Minimes, essai 10 €.';
const path = '/';
const preloadHero = true;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Je n’ai jamais boxé. Je peux venir ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Oui. Le TMBC est un club de boxe anglaise à Toulouse ouvert aux débutants. Les cours loisirs : technique, sac, assauts maîtrisés. Personne ne vous met en opposition. Essai 10 €, gants prêtés.',
      },
    },
    {
      '@type': 'Question',
      name: 'Combien coûte l’essai ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '10 € la séance de boxe anglaise à Toulouse. Aucun dossier, aucun certificat. Gants et casque prêtés au club TMBC Minimes.',
      },
    },
    {
      '@type': 'Question',
      name: 'C’est quoi l’offre 29 € ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '4 semaines illimitées de boxe anglaise à Toulouse (loisirs, compétiteurs selon le niveau), 29 € par personne, sans engagement.',
      },
    },
    {
      '@type': 'Question',
      name: 'Quelle différence entre loisirs et compétiteurs ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'À Toulouse Minimes, les loisirs : technique, sac, assauts maîtrisés, pas d’opposition imposée. Les compétiteurs : entraînement licenciés en semaine et open sparring le samedi 18h30.',
      },
    },
    {
      '@type': 'Question',
      name: 'On m’oblige à sparrer ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Non. Le seul open sparring est le samedi 18h30, entre licenciés du cours compétiteurs.',
      },
    },
    {
      '@type': 'Question',
      name: 'Il y a des cours enfants ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Dès 3 ans, école de boxe anglaise à Toulouse. Baby Boxe 250 €, éducative 295 € l’année, t-shirt inclus. Aucun coup porté chez les petits.',
      },
    },
    {
      '@type': 'Question',
      name: 'C’est un club pour débutants ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Oui. Débutant boxe à Toulouse : le club TMBC accueille les premiers gants en boxe anglaise loisirs. Pas de sparring imposé, coach dès la première séance, gants prêtés.',
      },
    },
    {
      '@type': 'Question',
      name: 'Quel club de boxe anglaise à Toulouse ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Le TMBC est un club de boxe anglaise à Toulouse Minimes (club Toulouse, 10 rue de Fenouillet, Barrière de Paris). Boxe anglaise uniquement : débutants, loisirs, compétiteurs et école.',
      },
    },
    {
      '@type': 'Question',
      name: 'Où pratiquer la boxe anglaise à Toulouse ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Au TMBC, club de boxe anglaise Toulouse Minimes, 10 rue de Fenouillet, 31200 Toulouse. Métro B Barrière de Paris, 3 min. Lundi–samedi 10h–21h30. Cours loisirs, compétiteurs et école.',
      },
    },
  ],
};
---
<Base title={title} description={description} path={path} preloadHero={preloadHero} jsonLd={jsonLd}>
<main id="main">
    <header class="hero hero--banner" aria-label="Toulouse Minimes Boxing Club">
      <img class="hero__bg" src="/assets/img/club-boxe-anglaise-toulouse-minimes-tmbc.webp" width="1600" height="854" alt="Toulouse Minimes Boxing Club — club de boxe anglaise à Toulouse, loisirs et compétition, depuis 2017" fetchpriority="high" />
      <div class="hero__veil"></div>
        <div class="hero__pitch">
        <h1>Club de boxe à Toulouse</h1>
        <p>Boxe anglaise Minimes : débutants, loisirs, compétiteurs et boxe éducative filles et garçons dès 3 ans. Tarifs, horaires des cours, photos, plan d’accès. Essai 10 €. FFBoxe.</p>
      </div>
      <div class="hero__foot">
        <ul class="hero__facts" data-reveal>
          <li class="hfact"><b>Essai 10 €</b><span>Une séance · gants prêtés</span></li>
          <li class="hfact"><b>4 semaines 29 €</b><span>Boxe anglaise, sans engagement</span></li>
          <li class="hfact"><b>Métro B · 3 min</b><span>Barrière de Paris</span></li>
        </ul>
        <p class="hero__cta" data-reveal>
          <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/offre/29">Je m’inscris — 29 €</a>
          <a class="btn" href="https://boutique.boxingcenter.fr/seance-essai">Réserver l’essai</a>
        </p>
      </div>
    </header>

    <aside class="dealbar">
      <div class="wrap">
        <p><b>4 semaines illimitées à 29 €</b><span>Offre rentrée · boxe anglaise · inscription en ligne</span></p>
        <p class="btn-row">
          <a class="btn" href="https://boutique.boxingcenter.fr/offre/29">Je m’inscris</a>
          <a class="btn btn--ghost" href="https://boutique.boxingcenter.fr/seance-essai">Essai 10 €</a>
        </p>
      </div>
    </aside>

    <div class="marquee" aria-hidden="true"><div class="marquee__track" id="marquee"></div></div>

    <aside class="juice">
      <div class="wrap">
        <p>Club de boxe à Toulouse (31), affilié FFBoxe. Boxe anglaise uniquement, au Toulouse Minimes Boxing Club (TMBC). Aussi sur <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">Boxing Center Minimes</a> et <a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a>.</p>
      </div>
    </aside>

    <section class="section">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Les formules</p>
        <h2 class="heading" data-reveal>Choisissez comment vous commencez</h2>
        <div class="offers" data-reveal-group style="margin-top:1.6rem">
          <article class="offer">
            <h3>Essai</h3>
            <b><span data-count="10">0</span> €</b>
            <p>Une séance de boxe anglaise à Toulouse, même débutant. Gants prêtés. Aucun dossier, aucun certificat.</p>
            <a class="btn" href="https://boutique.boxingcenter.fr/seance-essai">Réserver l’essai</a>
          </article>
          <article class="offer is-hot">
            <h3>Offre rentrée</h3>
            <b><s>44 €</s> <span data-count="29">0</span> €</b>
            <p>4 semaines, cours illimités de boxe anglaise à Toulouse (loisirs et compétiteurs). 29 € par personne, sans engagement.</p>
            <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/offre/29">Je m’inscris</a>
          </article>
          <article class="offer">
            <h3>Saison</h3>
            <b><s>400 €</s> <span data-count="259">0</span> €</b>
            <p>12 mois, payable en 4× sans frais. Accès à 5 salles à Toulouse et alentours.</p>
            <a class="btn" href="https://boutique.boxingcenter.fr/offre/259">Prendre la saison</a>
          </article>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap split">
        <div data-reveal>
          <p class="eyebrow">Pourquoi TMBC</p>
          <h2 class="heading">Club Toulouse : encadré dès la première séance, même débutant</h2>
          <p class="lead" style="margin-top:1rem">Le TMBC — Toulouse Minimes Boxing Club — est le club de boxe anglaise des Minimes, 10 rue de Fenouillet. Club boxe anglaise Toulouse : débutants, loisirs, compétiteurs, école.</p>
          <ul class="why">
            <li><b>01</b> <span>Un coach diplômé vous place : pieds, garde, jab.</span></li>
            <li><b>02</b> <span>Gants et casque prêtés à l’essai. Vous venez en tenue de sport.</span></li>
            <li><b>03</b> <span>Pas de sparring imposé. Le seul open est le samedi 18h30, entre licenciés compétiteurs.</span></li>
            <li><b>04</b> <span>3 minutes du métro B Barrière de Paris. Ouvert lundi–samedi 10h–21h30.</span></li>
          </ul>
          <p class="btn-row">
            <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/seance-essai">Réserver l’essai — 10 €</a>
            <a class="btn" href="/club">Voir la salle</a>
          </p>
        </div>
        <div class="frame" data-reveal>
          <img src="/assets/media/club-boxe-anglaise-toulouse-minimes.webp" alt="Club de boxe anglaise TMBC à Toulouse Minimes, 10 rue de Fenouillet" width="1600" height="1064" />
          <span class="frame__tag">500 m² · 10 rue de Fenouillet</span>
        </div>
      </div>
    </section>

    <section class="section band-tint">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Pour qui</p>
        <h2 class="heading" data-reveal>Club boxe anglaise Toulouse : débutants, loisirs, compétiteurs, enfants</h2>
        <div class="doors" data-reveal-group style="margin-top:1.6rem">
          <a class="door" href="/activites#loisirs">
            <img src="/assets/media/cours-boxe-loisirs-debutant-toulouse.webp" alt="Cours de boxe débutant et loisirs au club TMBC Toulouse" width="1024" height="768" loading="lazy" decoding="async" />
            <p class="eyebrow">Débutant boxe · Toulouse</p>
            <h3>Boxe anglaise loisirs</h3>
            <p>Club de boxe anglaise à Toulouse pour débutants. Technique, sac, assauts maîtrisés. Personne ne vous met en opposition.</p>
          </a>
          <a class="door" href="/activites#competiteurs">
            <img src="/assets/media/boxe-anglaise-competiteurs-toulouse.webp" alt="Entraînement boxe anglaise compétiteurs à Toulouse" width="1200" height="814" loading="lazy" decoding="async" />
            <p class="eyebrow">Lun mar jeu ven 18h · open samedi</p>
            <h3>Boxe anglaise compétiteurs</h3>
            <p>Boxe anglaise compétiteurs à Toulouse. Entraînement licenciés. Open sparring samedi 18h30, encadré.</p>
          </a>
          <a class="door" href="/activites#educative">
            <img src="/assets/media/ecole-boxe-enfants-toulouse-tmbc.webp" alt="École de boxe anglaise enfants à Toulouse Minimes" width="768" height="1024" loading="lazy" decoding="async" />
            <p class="eyebrow">Dès 3 ans · t-shirt inclus</p>
            <h3>Enfants</h3>
            <p>École de boxe anglaise à Toulouse. Baby Boxe 250 €, éducative 295 €. Aucun coup porté chez les petits.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Les cours</p>
        <h2 class="heading" data-reveal>Créneaux de boxe anglaise à Toulouse, sans jargon</h2>
        <div class="courses" style="margin-top:1.2rem">
          <a class="course" href="/activites#loisirs"><span class="course__n">01</span><div><h3>Boxe anglaise loisirs</h3><p>Débutant boxe à Toulouse · midi 12h40 et soir 19h40 · pas d’opposition imposée</p></div><span>Voir →</span></a>
          <a class="course" href="/activites#competiteurs"><span class="course__n">02</span><div><h3>Boxe anglaise compétiteurs</h3><p>Toulouse · lun mar jeu ven 18h · open sparring samedi 18h30</p></div><span>Voir →</span></a>
          <a class="course" href="/activites#educative"><span class="course__n">03</span><div><h3>École de boxe anglaise</h3><p>Enfants à Toulouse · mercredi et samedi · Baby, éducative, ados</p></div><span>Voir →</span></a>
        </div>
        <p class="btn-row" style="margin-top:1.4rem">
          <a class="btn btn--primary" href="https://boxe-toulouse.com/plannings/" target="_blank" rel="noopener">Voir le planning</a>
          <a class="btn" href="/activites">Toutes les activités</a>
        </p>
      </div>
    </section>

    <section class="section band-tint" id="coach">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Le coach</p>
        <div class="coach-lead" data-reveal>
          <div class="coach-lead__copy">
            <h2 class="heading coach-lead__title">
              <span class="coach-lead__kicker">Notre coach principal :</span>
              <span class="coach-lead__name" aria-label="Mehdi">
                <span>M</span><span>e</span><span>h</span><span>d</span><span>i</span>
              </span>
            </h2>
            <p class="lead">Mehdi dirige le plateau de boxe anglaise à Toulouse : cours loisirs, compétiteurs et école.</p>
          </div>
          <figure class="coach-lead__frame">
            <img src="/assets/media/coach-mehdi-boxe-anglaise-toulouse.webp" alt="Mehdi, coach de boxe anglaise au TMBC Toulouse Minimes" width="1200" height="1800" loading="lazy" />
            <figcaption class="coach-lead__badge">Coach principal</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Avis adhérents</p>
        <h2 class="heading" data-reveal>Ce que vous entendrez en vestiaire</h2>
        <div class="quotes" data-reveal-group style="margin-top:1.8rem">
          <blockquote>
            <p>« Je n’avais jamais fait de sport de combat. En trois séances, j’avais compris la garde et le direct. Personne ne se moque. »</p>
            <footer>Thomas L. · Boxe anglaise loisirs</footer>
          </blockquote>
          <blockquote>
            <p>« L’entraînement 18h, l’open du samedi : on progresse pour de vrai, encadré. Mehdi ne laisse rien passer. »</p>
            <footer>Nicolas D. · Boxe anglaise compétiteurs</footer>
          </blockquote>
          <blockquote>
            <p>« Mon fils y va depuis ses 6 ans. Il a gagné en confiance — et n’a jamais pris un coup qu’il n’avait pas choisi. »</p>
            <footer>Karim B. · Parent, boxe éducative</footer>
          </blockquote>
          <blockquote>
            <p>« Les cours d’anglaise du soir, 40 minutes, et je rentre. Mehdi corrige, personne ne juge. »</p>
            <footer>Léa P. · Boxe anglaise loisirs</footer>
          </blockquote>
          <blockquote>
            <p>« Très belle salle, matos au top, coachs et staff accueillants. On progresse dès la première semaine. »</p>
            <footer>Hamed S. · Boxe anglaise loisirs</footer>
          </blockquote>
          <blockquote>
            <p>« Ma fille a 8 ans. Elle aime les mercredis. Pas de coups, que de la technique et du jeu. »</p>
            <footer>Sophie V. · Parent, école de boxe</footer>
          </blockquote>
        </div>
      </div>
    </section>

    <section class="section band-tint" id="boutique">
      <div class="wrap">
        <p class="eyebrow" data-reveal>La boutique</p>
        <h2 class="heading" data-reveal>Le matériel, le même qu’en salle</h2>
        <p class="lead" data-reveal>Gants, bandes, protections, packs enfants. Commande en ligne, retrait aux Minimes.</p>
        <div class="shopgrid" data-reveal-group>
          <a class="shopcard" href="https://boutique.boxingcenter.fr/materiel/produit/gants-boxe-blade-noir-blanc" target="_blank" rel="noopener">
            <img src="/assets/shop/blade.jpg" alt="Gants de boxe Blade noir et blanc" width="400" height="400" loading="lazy" />
            <h3>Gants Blade</h3>
            <p>17,90 € · 10 / 12 / 14 oz</p>
          </a>
          <a class="shopcard" href="https://boutique.boxingcenter.fr/materiel/produit/gants-sparring-mbgan010n14-16oz" target="_blank" rel="noopener">
            <img src="/assets/shop/sparring.jpg" alt="Gants de sparring Metal Boxe 16 oz" width="400" height="400" loading="lazy" />
            <h3>Gants sparring 16 oz</h3>
            <p>34,90 € · Metal Boxe</p>
          </a>
          <a class="shopcard" href="https://boutique.boxingcenter.fr/materiel/produit/gants-ergo-90-mbg301k14" target="_blank" rel="noopener">
            <img src="/assets/shop/ergo.jpg" alt="Gants ERGO 90 Metal Boxe 14 oz" width="400" height="400" loading="lazy" />
            <h3>Gants ERGO 90</h3>
            <p>24,90 € · 14 oz</p>
          </a>
          <a class="shopcard" href="https://boutique.boxingcenter.fr/materiel/produit/bandes-4m-mb120bt" target="_blank" rel="noopener">
            <img src="/assets/shop/bandes-4m.jpg" alt="Bandes de boxe 4 mètres rouge blanc bleu" width="400" height="400" loading="lazy" />
            <h3>Bandes 4 m</h3>
            <p>6,90 € · rouge / blanc / bleu</p>
          </a>
          <a class="shopcard" href="https://boutique.boxingcenter.fr/materiel/produit/protege-dents-adulte-mbpro458srt" target="_blank" rel="noopener">
            <img src="/assets/shop/dents-adulte.jpg" alt="Protège-dents adulte gel" width="400" height="400" loading="lazy" />
            <h3>Protège-dents adulte</h3>
            <p>5,90 € · gel thermoformable</p>
          </a>
          <a class="shopcard" href="https://boutique.boxingcenter.fr/materiel/produit/pack-enfants-gants-mitaines-porte-cles" target="_blank" rel="noopener">
            <img src="/assets/shop/pack-enfants.jpg" alt="Pack enfants gants mitaines et porte-clés" width="400" height="400" loading="lazy" />
            <h3>Pack enfants</h3>
            <p>25 € · gants + mitaines</p>
          </a>
          <a class="shopcard" href="https://boutique.boxingcenter.fr/materiel/produit/gants-boxe-enfant-one" target="_blank" rel="noopener">
            <img src="/assets/shop/gants-enfant.jpg" alt="Gants de boxe enfant ONE" width="400" height="400" loading="lazy" />
            <h3>Gants enfant ONE</h3>
            <p>19,90 € · 4/7 ou 8/15 ans</p>
          </a>
          <a class="shopcard" href="https://boutique.boxingcenter.fr/materiel/produit/ensemble-enfants-short-debardeur" target="_blank" rel="noopener">
            <img src="/assets/shop/ensemble-enfants.jpg" alt="Ensemble enfants short et débardeur de boxe" width="400" height="400" loading="lazy" />
            <h3>Ensemble enfants</h3>
            <p>24,90 € · short + débardeur</p>
          </a>
          <a class="shopcard" href="https://boutique.boxingcenter.fr/materiel/produit/protege-dents-enfants-mb459jrw" target="_blank" rel="noopener">
            <img src="/assets/shop/dents-enfants.png" alt="Protège-dents enfants" width="400" height="400" loading="lazy" />
            <h3>Protège-dents enfants</h3>
            <p>12 € · gel, taille junior</p>
          </a>
        </div>
        <p class="btn-row" style="margin-top:1.4rem" data-reveal>
          <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/materiel" target="_blank" rel="noopener">Toute la boutique</a>
        </p>
      </div>
    </section>

    <section class="section" id="faq">
      <div class="wrap home-faq">
        <p class="eyebrow" data-reveal>Questions fréquentes</p>
        <h2 class="heading" data-reveal>Avant de pousser la porte</h2>
        <div class="faq" style="margin-top:1.2rem">
          <details open><summary>Je n’ai jamais boxé. Je peux venir ?</summary><p>Oui. Le TMBC est un club de boxe anglaise à Toulouse ouvert aux débutants. Cours loisirs : technique, sac, assauts maîtrisés. Personne ne vous met en opposition. Essai 10 €, gants prêtés.</p></details>
          <details><summary>C’est un club pour débutants ?</summary><p>Oui. Débutant boxe à Toulouse : le club accueille les premiers gants en boxe anglaise loisirs. Pas de sparring imposé, coach dès la première séance, gants prêtés.</p></details>
          <details><summary>Quel club de boxe anglaise à Toulouse ?</summary><p>Le TMBC, club Toulouse Minimes, 10 rue de Fenouillet, Barrière de Paris. Club de boxe anglaise uniquement : débutants, loisirs, compétiteurs et école.</p></details>
          <details><summary>Combien coûte l’essai ?</summary><p>10 € la séance de boxe anglaise à Toulouse. Aucun dossier, aucun certificat. Gants et casque prêtés au TMBC.</p></details>
          <details><summary>C’est quoi l’offre 29 € ?</summary><p>4 semaines illimitées de boxe anglaise à Toulouse, 29 € par personne, sans engagement. Inscription en ligne.</p></details>
          <details><summary>Quelle différence entre loisirs et compétiteurs ?</summary><p>Boxe anglaise loisirs à Toulouse : technique, sac, assauts maîtrisés — pas d’opposition imposée. Boxe anglaise compétiteurs : entraînement licenciés en semaine (lun mar jeu ven 18h) et open sparring le samedi 18h30.</p></details>
          <details><summary>On m’oblige à sparrer ?</summary><p>Non. Le seul open sparring du club de boxe anglaise TMBC est le samedi 18h30, entre licenciés du cours compétiteurs.</p></details>
          <details><summary>Il y a des cours enfants ?</summary><p>Oui, école de boxe anglaise à Toulouse dès 3 ans. Baby Boxe 250 €, éducative 295 € l’année, t-shirt inclus. Aucun coup porté chez les petits. Mercredi et samedi.</p></details>
          <details><summary>Quel matériel faut-il ?</summary><p>Pour l’essai : tenue de sport et une bouteille d’eau. Ensuite, gants Blade, sparring 16 oz, bandes 4 m, protège-dents et packs enfants se commandent à la boutique, retrait aux Minimes.</p></details>
          <details><summary>Où pratiquer la boxe anglaise à Toulouse ?</summary><p>TMBC, club de boxe anglaise Toulouse Minimes, 10 rue de Fenouillet, 31200 Toulouse. Métro B Barrière de Paris, 3 min. Lundi–samedi 10h–21h30. Fermé dimanche.</p></details>
        </div>
      </div>
    </section>

    <section class="section" id="reseau">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Sites officiels</p>
        <h2 class="heading" data-reveal>Boxing Center Minimes, et Boxing Center</h2>
        <p class="lead" data-reveal>Le TMBC est le Toulouse Minimes Boxing Club. Nos sites partenaires :</p>
        <ul class="partner-list" data-reveal>
          <li><a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">Boxing Center Minimes</a></li>
          <li><a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a></li>
        </ul>
        <div class="netgrid netgrid--duo" data-reveal-group>
          <a class="netcard" href="https://boxe-toulouse.com/" target="_blank" rel="noopener">
            <span class="eyebrow">Minimes</span>
            <b>Boxing Center Minimes</b>
            <p>Le site de Boxing Center Minimes : cours, planning, essai 10 €, offre 29 €. boxe-toulouse.com</p>
