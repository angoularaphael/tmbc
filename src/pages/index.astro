---
import Base from '../layouts/Base.astro';
import SeoLinks from '../components/SeoLinks.astro';
const title = 'Club boxe Toulouse | Boxe anglaise Minimes | TMBC';
const description = 'Club boxe Toulouse : boxe anglaise aux Minimes, débutants, loisirs, compétiteurs et école dès 3 ans. Tarifs, horaires des cours, photos et plan d’accès. FFBoxe, essai 10 €.';
const path = '/';
const preloadHero = true;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Je n’ai jamais boxé. Je peux venir ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Oui. Le TMBC est un club de boxe anglaise à Toulouse ouvert aux débutants. Les cours loisirs : technique, sac, assauts maîtrisés. Personne ne vous met en opposition. Essai 10 €, gants prêtés.',
      },
    },
    {
      '@type': 'Question',
      name: 'Combien coûte l’essai ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '10 € la séance de boxe anglaise à Toulouse. Aucun dossier, aucun certificat. Gants et casque prêtés au club TMBC Minimes.',
      },
    },
    {
      '@type': 'Question',
      name: 'Quels sont les tarifs de la saison ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '295 € par saison adultes et 250 € par saison enfants. Renseignements via le formulaire de contact.',
      },
    },
    {
      '@type': 'Question',
      name: 'Quelle différence entre loisirs et compétiteurs ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'À Toulouse Minimes, les loisirs : technique, sac, assauts maîtrisés, pas d’opposition imposée. Les compétiteurs : entraînement encadré du lundi au vendredi de 17h30 à 20h.',
      },
    },
    {
      '@type': 'Question',
      name: 'On m’oblige à sparrer ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Non. Les assauts sont adaptés au niveau et encadrés par le coach.',
      },
    },
    {
      '@type': 'Question',
      name: 'Il y a des cours enfants ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Dès 3 ans, école de boxe anglaise à Toulouse. Boxe enfants : 250 € par saison. Aucun coup porté chez les petits.',
      },
    },
    {
      '@type': 'Question',
      name: 'C’est un club pour débutants ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Oui. Débutant boxe à Toulouse : le club TMBC accueille les premiers gants en boxe anglaise loisirs. Pas de sparring imposé, coach dès la première séance, gants prêtés.',
      },
    },
    {
      '@type': 'Question',
      name: 'Quel club boxe à Toulouse ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Le TMBC — Toulouse Minimes Boxing Club — est un club boxe Toulouse dédié à la boxe anglaise : 10 rue de Fenouillet, Barrière de Paris. Débutants, loisirs, compétiteurs et école dès 3 ans. Essai 10 €.',
      },
    },
    {
      '@type': 'Question',
      name: 'Quel club de boxe anglaise à Toulouse ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Le TMBC est un club de boxe anglaise à Toulouse Minimes (club Toulouse, 10 rue de Fenouillet, Barrière de Paris). Boxe anglaise uniquement : débutants, loisirs, compétiteurs et école.',
      },
    },
    {
      '@type': 'Question',
      name: 'Où pratiquer la boxe anglaise à Toulouse ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Au TMBC, club de boxe anglaise Toulouse Minimes, 10 rue de Fenouillet, 31200 Toulouse. Métro B Barrière de Paris, 3 min. Lundi–vendredi 17h30–20h ; enfants mercredi et samedi 18h–19h. Cours loisirs, compétiteurs et école.',
      },
    },
  ],
};
---
<Base title={title} description={description} path={path} preloadHero={preloadHero} jsonLd={jsonLd}>
<main id="main">
    <header class="hero hero--banner" aria-label="Toulouse Minimes Boxing Club">
      <img class="hero__bg" src="/assets/img/club-boxe-anglaise-toulouse-minimes-tmbc.webp" width="1600" height="854" alt="Toulouse Minimes Boxing Club — club de boxe anglaise à Toulouse, loisirs et compétition, depuis 2017" fetchpriority="high" />
      <div class="hero__veil"></div>
        <div class="hero__pitch">
        <h1>Club boxe Toulouse</h1>
        <p>Boxe anglaise aux Minimes : débutants, loisirs, compétiteurs et boxe éducative filles et garçons dès 3 ans. Tarifs, horaires des cours, photos, plan d’accès. Essai 10 €. FFBoxe.</p>
      </div>
      <div class="hero__foot">
        <ul class="hero__facts" data-reveal>
          <li class="hfact"><b>Essai 10 €</b><span>Une séance · gants prêtés</span></li>
          <li class="hfact"><b>Adultes : 295 €/saison</b><span>Boxe anglaise, tarif saison</span></li>
          <li class="hfact"><b>Métro B · 3 min</b><span>Barrière de Paris</span></li>
        </ul>
        <p class="hero__cta" data-reveal>
          <a class="btn btn--primary" href="/contact">Contacter le club</a>
          <a class="btn" href="/contact">Réserver l’essai</a>
        </p>
      </div>
    </header>

    <aside class="dealbar">
      <div class="wrap">
        <p><b>Adultes : 295 € par saison</b><span>Enfants : 250 € par saison · renseignements auprès du club</span></p>
        <p class="btn-row">
          <a class="btn" href="/contact">Je m’inscris</a>
          <a class="btn btn--ghost" href="/contact">Essai 10 €</a>
        </p>
      </div>
    </aside>

    <div class="marquee" aria-hidden="true"><div class="marquee__track" id="marquee"></div></div>

    <aside class="juice">
      <div class="wrap">
        <p>Club boxe Toulouse (31), affilié FFBoxe. Boxe anglaise uniquement, au Toulouse Minimes Boxing Club (TMBC). Aussi sur <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">Boxing Center Minimes</a> et <a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a>.</p>
      </div>
    </aside>

    <section class="section">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Les formules</p>
        <h2 class="heading" data-reveal>Choisissez comment vous commencez</h2>
        <div class="offers season-offers" data-reveal-group style="margin-top:1.6rem">
          <article class="offer"><h3>Adultes</h3><b>295 €</b><p>Par saison · boxe anglaise.</p><a class="btn btn--primary" href="/contact">Contacter le club</a></article>
          <article class="offer"><h3>Enfants</h3><b>250 €</b><p>Par saison · boxe enfants.</p><a class="btn btn--primary" href="/contact">Contacter le club</a></article>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap split">
        <div data-reveal>
          <p class="eyebrow">Pourquoi TMBC</p>
          <h2 class="heading">Club boxe Toulouse : encadré dès la première séance, même débutant</h2>
          <p class="lead" style="margin-top:1rem">Le TMBC — Toulouse Minimes Boxing Club — est le club boxe Toulouse des Minimes, 10 rue de Fenouillet. Boxe anglaise : débutants, loisirs, compétiteurs, école.</p>
          <ul class="why">
            <li><b>01</b> <span>Un coach diplômé vous place : pieds, garde, jab.</span></li>
            <li><b>02</b> <span>Gants et casque prêtés à l’essai. Vous venez en tenue de sport.</span></li>
            <li><b>03</b> <span>Pas de sparring imposé. Les assauts sont adaptés au niveau et encadrés par le coach.</span></li>
            <li><b>04</b> <span>3 minutes du métro B Barrière de Paris. Cours : lundi–vendredi 17h30–20h ; enfants mercredi et samedi 18h–19h.</span></li>
          </ul>
          <p class="btn-row">
            <a class="btn btn--primary" href="/contact">Réserver l’essai — 10 €</a>
            <a class="btn" href="/club">Voir la salle</a>
          </p>
        </div>
        <div class="frame" data-reveal>
          <img src="/assets/media/club-boxe-anglaise-toulouse-minimes.webp" alt="Club de boxe anglaise TMBC à Toulouse Minimes, 10 rue de Fenouillet" width="1600" height="1064" />
          <span class="frame__tag">500 m² · 10 rue de Fenouillet</span>
        </div>
      </div>
    </section>

    <section class="section band-tint">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Pour qui</p>
        <h2 class="heading" data-reveal>Club boxe anglaise Toulouse : débutants, loisirs, compétiteurs, enfants</h2>
        <div class="doors" data-reveal-group style="margin-top:1.6rem">
          <a class="door" href="/activites#loisirs">
            <img src="/assets/media/cours-boxe-loisirs-debutant-toulouse.webp" alt="Cours de boxe débutant et loisirs au club TMBC Toulouse" width="1024" height="768" loading="lazy" decoding="async" />
            <p class="eyebrow">Débutant boxe · Toulouse</p>
            <h3>Boxe anglaise loisirs</h3>
            <p>Club de boxe anglaise à Toulouse pour débutants. Technique, sac, assauts maîtrisés. Personne ne vous met en opposition.</p>
          </a>
          <a class="door" href="/activites#competiteurs">
            <img src="/assets/media/boxe-anglaise-competiteurs-toulouse.webp" alt="Entraînement boxe anglaise compétiteurs à Toulouse" width="1200" height="814" loading="lazy" decoding="async" />
            <p class="eyebrow">Lundi au vendredi 17h30–20h</p>
            <h3>Boxe anglaise compétiteurs</h3>
            <p>Boxe anglaise compétiteurs à Toulouse. Entraînement licenciés. Travail technique et assauts encadrés.</p>
          </a>
          <a class="door" href="/activites#educative">
            <img src="/assets/media/ecole-boxe-enfants-toulouse-tmbc.webp" alt="École de boxe anglaise enfants à Toulouse Minimes" width="768" height="1024" loading="lazy" decoding="async" />
            <p class="eyebrow">Dès 3 ans · t-shirt inclus</p>
            <h3>Enfants</h3>
            <p>École de boxe anglaise à Toulouse. Boxe enfants : 250 € par saison. Aucun coup porté chez les petits.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Les cours</p>
        <h2 class="heading" data-reveal>Créneaux de boxe anglaise à Toulouse, sans jargon</h2>
        <div class="courses" style="margin-top:1.2rem">
          <a class="course" href="/activites#loisirs"><span class="course__n">01</span><div><h3>Boxe anglaise loisirs</h3><p>Débutant boxe à Toulouse · lundi au vendredi 17h30–20h · pas d’opposition imposée</p></div><span>Voir →</span></a>
          <a class="course" href="/activites#competiteurs"><span class="course__n">02</span><div><h3>Boxe anglaise compétiteurs</h3><p>Toulouse · lundi au vendredi 17h30–20h</p></div><span>Voir →</span></a>
          <a class="course" href="/activites#educative"><span class="course__n">03</span><div><h3>École de boxe anglaise</h3><p>Enfants à Toulouse · mercredi et samedi · Baby, éducative, ados</p></div><span>Voir →</span></a>
        </div>
        <p class="btn-row" style="margin-top:1.4rem">
          <a class="btn btn--primary" href="/planning">Voir le planning</a>
          <a class="btn" href="/activites">Toutes les activités</a>
        </p>
      </div>
    </section>

    <section class="section band-tint" id="coach">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Le coach</p>
        <div class="coach-lead" data-reveal>
          <div class="coach-lead__copy">
            <h2 class="heading coach-lead__title">
              <span class="coach-lead__kicker">Notre coach principal :</span>
              <span class="coach-lead__name" aria-label="Dadi">
                <span>D</span><span>a</span><span>d</span><span>i</span>
              </span>
            </h2>
            <p class="lead">Dadi Boutlelis, coach de boxe anglaise, est titulaire du Prévôt fédéral. Il accompagne les pratiquants loisirs et les compétiteurs, avec une expérience auprès de boxeurs professionnels et de haut niveau.</p>
          </div>
          <figure class="coach-lead__frame">
            <img src="/assets/media/coach-dadi-tmbc.png" alt="Dadi, coach de boxe anglaise au TMBC Toulouse Minimes" width="273" height="310" loading="lazy" />
            <figcaption class="coach-lead__badge">Coach principal</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Avis adhérents</p>
        <h2 class="heading" data-reveal>Ce que vous entendrez en vestiaire</h2>
        <div class="quotes" data-reveal-group style="margin-top:1.8rem">
          <blockquote>
            <p>« Je n’avais jamais fait de sport de combat. En trois séances, j’avais compris la garde et le direct. Personne ne se moque. »</p>
            <footer>Thomas L. · Boxe anglaise loisirs</footer>
          </blockquote>
          <blockquote>
            <p>« Mon fils y va depuis ses 6 ans. Il a gagné en confiance — et n’a jamais pris un coup qu’il n’avait pas choisi. »</p>
            <footer>Karim B. · Parent, boxe éducative</footer>
          </blockquote>
          <blockquote>
            <p>« Très belle salle, matos au top, coachs et staff accueillants. On progresse dès la première semaine. »</p>
            <footer>Hamed S. · Boxe anglaise loisirs</footer>
          </blockquote>
          <blockquote>
            <p>« Ma fille a 8 ans. Elle aime les mercredis. Pas de coups, que de la technique et du jeu. »</p>
            <footer>Sophie V. · Parent, école de boxe</footer>
          </blockquote>
        </div>
      </div>
    </section>

    <SeoLinks />

    <section class="section" id="faq">
      <div class="wrap home-faq">
        <p class="eyebrow" data-reveal>Questions fréquentes</p>
        <h2 class="heading" data-reveal>Avant de pousser la porte</h2>
        <div class="faq" style="margin-top:1.2rem">
          <details open><summary>Je n’ai jamais boxé. Je peux venir ?</summary><p>Oui. Le TMBC est un club de boxe anglaise à Toulouse ouvert aux débutants. Cours loisirs : technique, sac, assauts maîtrisés. Personne ne vous met en opposition. Essai 10 €, gants prêtés.</p></details>
          <details><summary>C’est un club pour débutants ?</summary><p>Oui. Débutant boxe à Toulouse : le club accueille les premiers gants en boxe anglaise loisirs. Pas de sparring imposé, coach dès la première séance, gants prêtés.</p></details>
          <details><summary>Quel club boxe à Toulouse ?</summary><p>Le TMBC — Toulouse Minimes Boxing Club — club boxe Toulouse aux Minimes, 10 rue de Fenouillet, Barrière de Paris. Boxe anglaise : débutants, loisirs, compétiteurs et école. Essai 10 €.</p></details>
          <details><summary>Quel club de boxe anglaise à Toulouse ?</summary><p>Le TMBC, club Toulouse Minimes, 10 rue de Fenouillet, Barrière de Paris. Club de boxe anglaise uniquement : débutants, loisirs, compétiteurs et école.</p></details>
          <details><summary>Combien coûte l’essai ?</summary><p>10 € la séance de boxe anglaise à Toulouse. Aucun dossier, aucun certificat. Gants et casque prêtés au TMBC.</p></details>
          <details><summary>Quels sont les tarifs de la saison ?</summary><p>295 € par saison adultes et 250 € par saison enfants. Renseignements et inscription via le formulaire de contact.</p></details>
          <details><summary>Quelle différence entre loisirs et compétiteurs ?</summary><p>Boxe anglaise loisirs à Toulouse : technique, sac, assauts maîtrisés — pas d’opposition imposée. Boxe anglaise compétiteurs : entraînement encadré du lundi au vendredi de 17h30 à 20h.</p></details>
          <details><summary>On m’oblige à sparrer ?</summary><p>Non. Les assauts sont adaptés au niveau et encadrés par le coach.</p></details>
          <details><summary>Il y a des cours enfants ?</summary><p>Oui, école de boxe anglaise à Toulouse dès 3 ans. Boxe enfants : 250 € par saison. Aucun coup porté chez les petits. Mercredi et samedi.</p></details>
          <details><summary>Quel matériel faut-il ?</summary><p>Pour l’essai : tenue de sport et une bouteille d’eau. Le club prête les gants. Ensuite, le <a href="https://boutique.boxingcenter.fr/">matériel de boxe</a> (gants, bandes, protège-dents) se commande en ligne ; le colis arrive chez vous. Voir aussi le <a href="https://boutique.boxingcenter.fr/">matériel de boxe Toulouse</a>.</p></details>
          <details><summary>Où pratiquer la boxe anglaise à Toulouse ?</summary><p>TMBC, club de boxe anglaise Toulouse Minimes, 10 rue de Fenouillet, 31200 Toulouse. Métro B Barrière de Paris, 3 min. Lundi–vendredi 17h30–20h ; enfants mercredi et samedi 18h–19h. Fermé dimanche.</p></details>
        </div>
      </div>
    </section>

    <section class="section" id="reseau">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Sites officiels</p>
        <h2 class="heading" data-reveal>Boxing Center Minimes, et Boxing Center</h2>
        <p class="lead" data-reveal>Le TMBC est le Toulouse Minimes Boxing Club. Nos sites partenaires :</p>
        <ul class="partner-list" data-reveal>
          <li><a href="/boxing-center-minimes">Boxing Center Minimes</a></li>
          <li><a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a></li>
          <li><a href="https://boutique.boxingcenter.fr/" target="_blank" rel="noopener">matériel de boxe</a></li>
          <li><a href="https://boutique.boxingcenter.fr/" target="_blank" rel="noopener">matériel de boxe Toulouse</a></li>
        </ul>
        <div class="netgrid" data-reveal-group>
          <a class="netcard" href="https://boxe-toulouse.com/" target="_blank" rel="noopener">
            <span class="eyebrow">Minimes</span>
            <b>Boxing Center Minimes</b>
            <p>Le site de Boxing Center Minimes : cours, planning, essai 10 €, tarifs saison. boxe-toulouse.com</p>
            <em>Voir le site →</em>
          </a>
          <a class="netcard" href="https://boxingcenter.fr/" target="_blank" rel="noopener">
            <span class="eyebrow">Le groupe</span>
            <b>Boxing Center</b>
            <p>Le site principal Boxing Center : les 5 salles, actualités, inscriptions et partenaires.</p>
            <em>Voir le site →</em>
          </a>
          <a class="netcard" href="https://boutique.boxingcenter.fr/" target="_blank" rel="noopener">
            <span class="eyebrow">Équipement</span>
            <b>matériel de boxe</b>
            <p>Gants, bandes, protections. Commande en ligne, colis chez vous. Aussi : matériel de boxe Toulouse.</p>
            <em>Voir le site →</em>
          </a>
        </div>
      </div>
    </section>

    <section class="closer" aria-label="Inscription">
      <img data-parallax src="/assets/media/ring-principal-1200.webp" alt="Ring de boxe anglaise du club TMBC à Toulouse Minimes" width="1600" height="1000" />
      <div class="wrap">
        <p class="eyebrow">Renseignements et inscription</p>
        <h2 class="display">Adultes : 295 € par saison</h2>
        <p class="lead">Club de boxe anglaise à Toulouse. Débutants bienvenus. Inscription auprès du club. Matériel prêté le temps de vous équiper.</p>
        <p class="btn-row" style="margin-top:1.4rem">
          <a class="btn btn--primary" href="/contact">Contacter le club</a>
          <a class="btn" href="/tarifs">Voir les tarifs</a>
        </p>
      </div>
    </section>
  </main>
</Base>
