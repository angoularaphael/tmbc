---
import { LINKS } from "../data/site.js";
---
<div class="float-dock">
  <button class="bag-trap__fab" type="button" data-bag-open aria-expanded="false" aria-controls="bag-stage">
    <span class="bag-trap__mini" aria-hidden="true"><i></i><b></b></span>
    <span>Offre</span>
  </button>
  <button class="to-top" type="button" data-totop hidden aria-label="Retour en haut de page">Haut</button>
</div>

<aside class="bag-trap" id="bag-trap">
  <div class="bag-trap__overlay" id="bag-stage" hidden>
    <div class="bag-trap__box" role="dialog" aria-labelledby="bag-title" aria-modal="true">
      <button class="bag-trap__close" type="button" data-bag-close aria-label="Fermer">×</button>
      <p class="kicker">Offre du moment</p>
      <h2 id="bag-title" class="display display--sm">3 coups pour 29 € ou 259 €.</h2>
      <p class="lede">Frappez le sac trois fois. Les deux offres s’affichent : 4 semaines à 29 €, ou la saison à 259 €. Inscription en ligne, immédiat.</p>

      <div class="heavy-bag" data-bag>
        <span class="heavy-bag__chain" aria-hidden="true"></span>
        <button class="heavy-bag__body" type="button" data-bag-hit aria-label="Frapper le sac">
          <span>SAC</span>
        </button>
      </div>

      <ol class="bag-trap__dots" data-bag-dots aria-hidden="true">
        <li></li><li></li><li></li>
      </ol>
      <p class="bag-trap__hits" data-bag-hits aria-live="polite">0 / 3</p>
      <p class="bag-trap__hint" data-bag-hint>Jab · crochet · direct</p>
      <p class="bag-trap__tease" data-bag-tease hidden></p>

      <div class="bag-trap__result" data-bag-result hidden>
        <p class="kicker">À vous de choisir</p>
        <p class="bag-trap__ko">Offre débloquée.</p>
        <div class="bag-trap__corners">
          <a class="bag-corner bag-corner--red" href={LINKS.rentree}>
            <span>Offre rentrée</span>
            <strong>29 €</strong>
            <em>4 semaines · sans engagement</em>
            <span class="btn"><span>Je prends 29 €</span></span>
          </a>
          <a class="bag-corner bag-corner--black" href={LINKS.saison}>
            <span>Offre saison</span>
            <strong>259 €</strong>
            <em>12 mois · les 5 salles</em>
            <span class="btn btn--ghost"><span>La saison</span></span>
          </a>
        </div>
      </div>
    </div>
  </div>
</aside>
