---
const {
  title = 'Adultes : 295 € par saison',
  lead = 'Enfants : 250 € par saison. Renseignements et inscription via le formulaire de contact.',
  primaryHref = '/contact',
  primaryLabel = 'Je m’inscris',
  secondaryHref = '/tarifs',
  secondaryLabel = 'Voir les tarifs',
} = Astro.props;
---
<section class="cta-band">
  <div class="wrap">
    <h2>{title}</h2>
    <p>{lead}</p>
    <p class="btn-row">
      <a class="btn btn--primary" href={primaryHref}>{primaryLabel}</a>
      {secondaryHref && <a class="btn" href={secondaryHref}>{secondaryLabel}</a>}
    </p>
  </div>
</section>
