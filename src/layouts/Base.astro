---
const SITE = 'https://toulouse-minimes-boxing-club.fr';
const {
  title,
  description,
  path = '/',
  ogTitle = title,
  jsonLd,
  preloadHero = false,
} = Astro.props;

const canonical = path === '/' ? `${SITE}/` : `${SITE}${path}`;
const ogImage = `${SITE}/assets/img/hero.png`;
const current = (Astro.url.pathname.replace(/\/$/, '') || '/');

const nav = [
  { href: '/', label: 'Accueil' },
  { href: '/club', label: 'Le club' },
  { href: '/activites', label: 'Activités' },
  { href: 'https://boxe-toulouse.com/plannings/', label: 'Planning', external: true },
  { href: 'https://boutique.boxingcenter.fr/abonnements', label: 'Tarifs', external: true },
  { href: '/galerie', label: 'Galerie' },
];

const sportsClub = {
  '@context': 'https://schema.org',
  '@type': ['SportsClub', 'SportsActivityLocation'],
  name: 'Toulouse Minimes Boxing Club',
  alternateName: ['TMBC', 'Club de boxe anglaise Toulouse', 'Club boxe Toulouse Minimes', 'Toulouse Minimes Boxing Club'],
  description: 'Club de boxe anglaise à Toulouse Minimes. Club Toulouse pour débutants, loisirs et compétiteurs. Cours de boxe anglaise, école dès 3 ans. 12 rue de Fenouillet, Barrière de Paris.',
  url: `${SITE}/`,
  email: 'bc.combat31@gmail.com',
  image: ogImage,
  sport: 'Boxing',
  knowsAbout: [
    'Club Toulouse',
    'Club de boxe Toulouse',
    'Club boxe anglaise Toulouse',
    'Boxe anglaise Toulouse',
    'Boxe débutant Toulouse',
    'Débutant boxe',
    'Cours de boxe débutant Toulouse',
    'Boxe anglaise loisirs Toulouse',
    'Boxe anglaise compétiteurs Toulouse',
    'Club de boxe Toulouse Minimes',
    'École de boxe anglaise Toulouse',
    'Salle de boxe Toulouse Barrière de Paris',
  ],
  areaServed: [
    { '@type': 'City', name: 'Toulouse' },
    { '@type': 'Place', name: 'Minimes, Toulouse' },
    { '@type': 'Place', name: 'Barrière de Paris, Toulouse' },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '12 rue de Fenouillet',
    addressLocality: 'Toulouse',
    addressRegion: 'Occitanie',
    postalCode: '31200',
    addressCountry: 'FR',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 43.6256, longitude: 1.4309 },
  openingHours: 'Mo-Sa 10:00-21:30',
  memberOf: { '@type': 'Organization', name: 'Boxing Center', url: 'https://boxingcenter.fr/' },
  sameAs: ['https://boxe-toulouse.com/', 'https://boxingcenter.fr/'],
};

function isCurrent(href) {
  if (href.startsWith('http')) return false;
  if (href === '/') return current === '/';
  return current === href || current.startsWith(`${href}/`);
}
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="author" content="Toulouse Minimes Boxing Club" />
  <meta name="keywords" content="club Toulouse, club de boxe Toulouse, club boxe anglaise Toulouse, boxe anglaise Toulouse, boxe débutant Toulouse, débutant boxe, cours boxe débutant Toulouse, club sport Toulouse, salle de boxe Toulouse, club de boxe anglaise Toulouse Minimes, boxe anglaise loisirs Toulouse, boxe anglaise compétiteurs Toulouse, école de boxe Toulouse, boxe enfants Toulouse, boxe Toulouse Barrière de Paris, TMBC, Toulouse Minimes Boxing Club, essai boxe 10€" />
  <meta name="geo.region" content="FR-31" />
  <meta name="geo.placename" content="Toulouse — Minimes — Barrière de Paris" />
  <meta name="geo.position" content="43.6256;1.4309" />
  <meta name="ICBM" content="43.6256, 1.4309" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="text/plain" title="LLM" href={`${SITE}/llms.txt`} />
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <meta name="theme-color" content="#f6f3ee" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/styles.css?v=11" />
  {preloadHero && <link rel="preload" as="image" href="/assets/img/hero.png" fetchpriority="high" />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="TMBC — Toulouse Minimes Boxing Club" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1920" />
  <meta property="og:image:height" content="1080" />
  <meta property="og:image:alt" content="Club de boxe anglaise TMBC à Toulouse — débutants, loisirs, compétiteurs" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <script type="application/ld+json" set:html={JSON.stringify(sportsClub)} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a class="skip" href="#main">Aller au contenu</a>
  <div class="wipe" aria-hidden="true"><i></i><i></i></div>
  <header class="nav" id="nav">
    <a class="nav__brand" href="/"><img class="nav__logo" src="/assets/img/logo.jpeg" width="180" height="74" alt="TMBC — Toulouse Minimes Boxing Club" /></a>
    <nav class="nav__links" aria-label="Pages du club">
      <ul>
        {nav.map((item) => (
          <li class={item.href === '/' ? 'nav__home' : undefined}>
            <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="nav__right">
      <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/offre/29">Je m’inscris</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="menu" aria-label="Menu"><span></span><span></span><span></span></button>
    </div>
  </header>
  <div class="menu" id="menu" hidden>
    <div></div>
    <nav class="menu__nav">
      {nav.map((item) => (
        <a class="menu__link" href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="menu__foot">
      <a href="mailto:bc.combat31@gmail.com">bc.combat31@gmail.com</a>
      <a class="btn btn--primary" href="https://boutique.boxingcenter.fr/offre/29">Je m’inscris</a>
    </div>
  </div>
  <slot />
  <footer class="site-footer">
    <div class="wrap foot-grid">
      <div>
        <a class="nav__brand" href="/" style="margin-bottom:12px"><img class="nav__logo" src="/assets/img/logo.jpeg" alt="TMBC" width="160" height="66" /></a>
        <p>TMBC — club de boxe anglaise à Toulouse. Club Toulouse Minimes pour débutants, loisirs, compétiteurs et enfants. 12 rue de Fenouillet, 31200 Toulouse, Barrière de Paris.</p>
        <p class="sisters">
          <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">Boxing Center Minimes</a>
          <a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a>
        </p>
      </div>
      <div>
        <p class="eyebrow">Salle</p>
        <p>12 rue de Fenouillet<br />31200 Toulouse<br />Métro B · Barrière de Paris</p>
      </div>
      <div>
        <p class="eyebrow">Contact</p>
        <p><a href="mailto:bc.combat31@gmail.com">bc.combat31@gmail.com</a></p>
      </div>
      <div>
        <p class="eyebrow">Sites officiels</p>
        <p class="net-links">
          <a href="https://boxe-toulouse.com/" target="_blank" rel="noopener">Boxing Center Minimes</a>
          <a href="https://boxingcenter.fr/" target="_blank" rel="noopener">Boxing Center</a>
        </p>
      </div>
    </div>
    <div class="wrap legal">
      <a href="/mentions-legales">Mentions légales</a>
      <span>Lun–sam 10h–21h30</span>
    </div>
  </footer>
  <script src="/assets/js/data.js?v=10" defer></script>
  <script src="/assets/js/main.js?v=10" defer></script>
</body>
</html>
