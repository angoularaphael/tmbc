{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/club.html", "destination": "/club", "permanent": true },
    { "source": "/activites.html", "destination": "/activites", "permanent": true },
    { "source": "/disciplines.html", "destination": "/activites", "permanent": true },
    { "source": "/disciplines", "destination": "/activites", "permanent": true },
    { "source": "/coachs", "destination": "/", "permanent": true },
    { "source": "/coachs.html", "destination": "/", "permanent": true },
    { "source": "/contact", "destination": "/", "permanent": true },
    { "source": "/contact.html", "destination": "/", "permanent": true },
    { "source": "/planning", "destination": "https://boxe-toulouse.com/plannings/", "permanent": false },
    { "source": "/planning.html", "destination": "https://boxe-toulouse.com/plannings/", "permanent": false },
    { "source": "/tarifs", "destination": "https://boutique.boxingcenter.fr/abonnements", "permanent": false },
    { "source": "/tarifs.html", "destination": "https://boutique.boxingcenter.fr/abonnements", "permanent": false },
    { "source": "/galerie.html", "destination": "/galerie", "permanent": true },
    { "source": "/mentions-legales.html", "destination": "/mentions-legales", "permanent": true }
  ]
}
