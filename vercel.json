{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; base-uri 'self'; form-action 'self' mailto:; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Content-Type", "value": "image/x-icon" }
      ]
    },
    {
      "source": "/favicon-48x48.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/favicon-96x96.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/sitemap-index.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/sitemap-0.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/sitemap-0.xml" }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.toulouse-minimes-boxing-club.fr" }],
      "destination": "https://toulouse-minimes-boxing-club.fr/",
      "statusCode": 308
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.toulouse-minimes-boxing-club.fr" }],
      "destination": "https://toulouse-minimes-boxing-club.fr/:path*",
      "statusCode": 308
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/qui-sommes-nous", "destination": "/club", "permanent": true },
    { "source": "/qui-sommes-nous.html", "destination": "/club", "permanent": true },
    { "source": "/a-propos", "destination": "/club", "permanent": true },
    { "source": "/planning-toulouse-minimes-boxing-club-tmbc", "destination": "/planning", "permanent": true },
    { "source": "/pole-inclusion-toulouse-minimes-boxing-club-tmbc", "destination": "/club", "permanent": true },
    { "source": "/pole-handi-sport-toulouse-minimes-boxing-club-tmbc", "destination": "/club", "permanent": true },
    { "source": "/pole-inclusion", "destination": "/club", "permanent": true },
    { "source": "/pole-handi-sport", "destination": "/club", "permanent": true },
    { "source": "/contactez-nous", "destination": "/", "permanent": true },
    { "source": "/contactez-nous.html", "destination": "/", "permanent": true },
    { "source": "/nous-contacter", "destination": "/", "permanent": true },
    { "source": "/club.html", "destination": "/club", "permanent": true },
    { "source": "/activites.html", "destination": "/activites", "permanent": true },
    { "source": "/disciplines.html", "destination": "/activites", "permanent": true },
    { "source": "/disciplines", "destination": "/activites", "permanent": true },
    { "source": "/coachs", "destination": "/", "permanent": true },
    { "source": "/coachs.html", "destination": "/", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/planning.html", "destination": "/planning", "permanent": false },
    { "source": "/tarifs.html", "destination": "/tarifs", "permanent": false },
    { "source": "/galerie.html", "destination": "/galerie", "permanent": true },
    { "source": "/mentions-legales.html", "destination": "/mentions-legales", "permanent": true }
  ]
}
